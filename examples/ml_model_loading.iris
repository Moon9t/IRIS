// examples/ml_model_loading.iris
// Real SQL-backed ML example using the std.sql connector.

bring std.ml
bring std.sql

def add_training_row(db : i64, x : f64, y : f64) -> i64 {
    sql_exec(db, concat("INSERT INTO training_samples (feature, target) VALUES (", concat(to_str(x), concat(", ", concat(to_str(y), ")")))))
}

def print_rows(rows : list<list<str>>) -> () {
    for i in 0 .. list_len(rows) {
        val row = list_get(rows, i);
        print(join(row, ", "));
    }
}

def main() -> i64 {
    print("=== SQL-Backed ML Training Example ===");

    val db = sql_open("iris_ml_training.db");
    if db == 0 {
        print("failed to open database");
        1
    } else {
        sql_exec(db, "DROP TABLE IF EXISTS training_samples");
        sql_exec(db, "CREATE TABLE training_samples (id INTEGER PRIMARY KEY AUTOINCREMENT, feature REAL, target REAL)");

        val _ = add_training_row(db, 1.0, 3.0);
        val _ = add_training_row(db, 2.0, 5.0);
        val _ = add_training_row(db, 3.0, 7.0);
        val _ = add_training_row(db, 4.0, 9.0);
        val _ = add_training_row(db, 5.0, 11.0);

        val rows = sql_query(db, "SELECT feature, target FROM training_samples ORDER BY id");
        print("Database rows:");
        print_rows(rows);
        print(concat("row count = ", to_str(list_len(rows))));

        val (features, targets) = sql_rows_to_xy(rows, 0, 1);
        val (w, b) = linear_regression_train(features, targets, 0.05, 1000);
        val prediction = linear_predict(w, b, 6.0 to f64);

        print(concat("trained w = ", to_str(w)));
        print(concat("trained b = ", to_str(b)));
        print(concat("prediction for x=6.0 = ", to_str(prediction)));
        print("Expected trend: y = 2x + 1");

        sql_close(db);
        0
    }
}
