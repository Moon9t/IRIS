// generics.iris - Parametric polymorphism, generic records, and Higher-Kinded Types (HKT)
//
// Run: iris run examples/04_types_and_traits/generics.iris

// =====================
//  Basic Generics
// =====================

def identity[T](v: T) -> T {
    v
}

def my_min[T](a: T, b: T) -> T {
    if a < b { a } else { b }
}

def my_max[T](a: T, b: T) -> T {
    if a > b { a } else { b }
}

def clamp[T](v: T, low: T, high: T) -> T {
    my_max(low, my_min(v, high))
}

def swap_i64(a: i64, b: i64) -> (i64, i64) {
    (b, a)
}

// =====================
//  Generic Records
// =====================

record Pair[T, U] {
    first: T,
    second: U,
}

record Box[T] {
    item: T
}

// =====================
//  Higher-Kinded Types (HKT)
// =====================

record Wrapper[F[_], A] {
    value: F<A>
}

def main() -> i64 {
    println("=== Basic Generics ===");
    println(concat("identity(42)       = ", to_str(identity(42))));
    println(concat("min(10, 20)        = ", to_str(my_min(10, 20))));
    println(concat("max(10, 20)        = ", to_str(my_max(10, 20))));
    println(concat("clamp(15, 0, 10)   = ", to_str(clamp(15, 0, 10))));

    println("\n=== Monomorphized for str ===");
    println(concat("identity(\"hello\")  = ", identity("hello")));

    println("\n=== Swap ===");
    val (a, b) = swap_i64(1, 2);
    println(concat("swap(1, 2) = (", concat(to_str(a), concat(", ", concat(to_str(b), ")")))));

    println("\n=== Generic Records ===");
    val p: Pair<i64, str> = Pair { first: 42, second: "hello" }
    println(concat("Pair.first = ", to_str(p.first)));
    println(concat("Pair.second = ", p.second));

    println("\n=== Higher-Kinded Types (HKT) ===");
    val w: Wrapper<Box, i64> = Wrapper {
        value: Box { item: 100 }
    }
    println(concat("Wrapper[Box, i64].value.item = ", to_str(w.value.item)));

    0
}
