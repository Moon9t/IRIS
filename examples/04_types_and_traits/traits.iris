// traits.iris — traits, dynamic dispatch, generic bounds and blanket impls
//
// The point of this file is what happens when those four combine: a
// heterogeneous `list<dyn Shape>` that computes over shapes it does not know
// the concrete types of, and a `describe` method nobody wrote for any shape.
//
// Run: iris run examples/04_types_and_traits/traits.iris

record Circle {
    radius: f64,
}

record Rectangle {
    width: f64,
    height: f64,
}

record Triangle {
    base: f64,
    height: f64,
}

// ---------------------------------------------------------------------------
// Traits
// ---------------------------------------------------------------------------

trait Shape {
    def area(self: Self) -> f64
    def name(self: Self) -> str
}

/// Implemented for nothing directly. Every `Shape` gets it from the blanket
/// impl below.
trait Describe {
    def describe(self: Self) -> str
}

// ---------------------------------------------------------------------------
// Implementations
// ---------------------------------------------------------------------------

impl Shape for Circle {
    def area(self: Circle) -> f64 {
        3.14159265 * self.radius * self.radius
    }
    def name(self: Circle) -> str {
        "circle"
    }
}

impl Shape for Rectangle {
    def area(self: Rectangle) -> f64 {
        self.width * self.height
    }
    def name(self: Rectangle) -> str {
        "rectangle"
    }
}

impl Shape for Triangle {
    def area(self: Triangle) -> f64 {
        0.5 * self.base * self.height
    }
    def name(self: Triangle) -> str {
        "triangle"
    }
}

/// A blanket impl: everything that is a `Shape` is also `Describe`, without a
/// line of per-type code. Adding a fourth shape below would get `describe` for
/// free.
impl[T where T: Shape] Describe for T {
    def describe(self: Self) -> str {
        self.name() + " of area " + to_str(self.area())
    }
}

// ---------------------------------------------------------------------------
// Generic function with a trait bound
// ---------------------------------------------------------------------------

/// Works for any `Shape`, resolved statically at each call site.
def is_larger_than[T where T: Shape](s: T, limit: f64) -> bool {
    s.area() > limit
}

// ---------------------------------------------------------------------------
// Dynamic dispatch over a heterogeneous collection
// ---------------------------------------------------------------------------

/// The caller's shapes have three different concrete types and three different
/// `area` implementations. This function knows none of them.
def total_area(shapes: list<dyn Shape>) -> f64 {
    var sum = 0.0;
    var i = 0;
    while i < list_len(shapes) {
        val s: dyn Shape = list_get(shapes, i);
        sum = sum + s.area();
        i = i + 1;
    }
    sum
}

/// Counts the shapes whose area clears `limit`, again without knowing types.
def count_larger(shapes: list<dyn Shape>, limit: f64) -> i64 {
    var n = 0;
    var i = 0;
    while i < list_len(shapes) {
        val s: dyn Shape = list_get(shapes, i);
        if s.area() > limit {
            n = n + 1;
        }
        i = i + 1;
    }
    n
}

def main() -> i64 {
    println("=== static dispatch ===");

    val c = Circle { radius: 2.0 };
    val r = Rectangle { width: 3.0, height: 4.0 };
    val t = Triangle { base: 6.0, height: 2.0 };

    // Each type's own implementation runs.
    assert(r.area() == 12.0);
    assert(t.area() == 6.0);
    assert(c.name() == "circle");
    assert(r.name() == "rectangle");
    assert(t.name() == "triangle");

    // The circle's area is irrational, so it is checked as a band rather than
    // an equality: pi * 4 is about 12.566.
    assert(c.area() > 12.56);
    assert(c.area() < 12.57);

    println("=== blanket impl ===");

    // Nobody wrote `describe` for Rectangle. It exists because Rectangle is a
    // Shape, and every Shape is Describable.
    println(r.describe());
    assert(r.describe() == "rectangle of area 12");
    assert(t.describe() == "triangle of area 6");
    // The blanket impl must call through to each type's own `name` and `area`,
    // so the three descriptions differ.
    assert(r.describe() != t.describe());

    println("=== generic bound ===");

    assert(is_larger_than(r, 10.0));
    assert(is_larger_than(t, 10.0) == false);
    // The same generic function, instantiated at a third type.
    assert(is_larger_than(c, 10.0));

    println("=== dynamic dispatch ===");

    // Three concrete types in one list, coerced to `dyn Shape` at the push.
    val shapes: list<dyn Shape> = list();
    list_push(shapes, r);
    list_push(shapes, t);
    list_push(shapes, Rectangle { width: 1.0, height: 5.0 });
    assert(list_len(shapes) == 3);

    // 12 + 6 + 5. If the vtable were stuck on one impl, this would be 36
    // (all rectangles) or 18 (all triangles) instead.
    val total = total_area(shapes);
    println("total area = " + to_str(total));
    assert(total == 23.0);

    assert(count_larger(shapes, 4.0) == 3);
    assert(count_larger(shapes, 5.5) == 2);
    assert(count_larger(shapes, 100.0) == 0);

    // A shape retrieved from the list still reports its own name.
    val first: dyn Shape = list_get(shapes, 0);
    assert(first.name() == "rectangle");
    val second: dyn Shape = list_get(shapes, 1);
    assert(second.name() == "triangle");

    println("traits ok");
    0
}
