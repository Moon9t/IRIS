bring std.ml

def print_list(v : list<f64>) -> () {
    var s : str = "[";
    for i in 0 .. list_len(v) {
        if i>0 {
            s = concat(s, ", ");
            
        }
        s = concat(s, to_str(list_get(v, i)));
        
    }
    print(concat(s, "]"));
    
}
def main() -> i64 {
    val input : list<f64> = [1.0, 0.5];
    val h1_w : list<f64> = [0.1, 0.2];
    val h2_w : list<f64> = [0.3, -0.2];
    val h3_w : list<f64> = [-0.1, 0.4];
    val h1_b = 0.05;
    val h2_b = - 0.1;
    val h3_b = 0.15;
    val input : list<f64> = list();
    list_push(input, 1.0);
    list_push(input, 0.5);
    val h1_w : list<f64> = list();
    list_push(h1_w, 0.1);
    list_push(h1_w, 0.2);
    val h2_w : list<f64> = list();
    list_push(h2_w, 0.3);
    list_push(h2_w, -0.2);
    val h3_w : list<f64> = list();
    list_push(h3_w, -0.1);
    list_push(h3_w, 0.4);
    val h1_b = 0.05;
    val h2_b = - 0.1;
    val h3_b = 0.15;
    val o1_w : list<f64> = list();
    list_push(o1_w, 0.2);
    list_push(o1_w, -0.1);
    list_push(o1_w, 0.4);
    val o2_w : list<f64> = list();
    list_push(o2_w, -0.3);
    list_push(o2_w, 0.5);
    list_push(o2_w, 0.1);
    val o1_b = 0.02;
    val o2_b = - 0.03;
    print("=== Neural Computation Example ===");
    print("input = ");
    print_list(input);
    val hidden1 = relu(dot(input, h1_w) + h1_b);
    val hidden2 = relu(dot(input, h2_w) + h2_b);
    val hidden3 = relu(dot(input, h3_w) + h3_b);
    val hidden : list<f64> = list();
    list_push(hidden, hidden1);
    list_push(hidden, hidden2);
    list_push(hidden, hidden3);
    print("hidden = ");
    print_list(hidden);
    val logit1 = dot(hidden, o1_w) + o1_b;
    val logit2 = dot(hidden, o2_w) + o2_b;
    val logits : list<f64> = list();
    list_push(logits, logit1);
    list_push(logits, logit2);
    print("logits = ");
    print_list(logits);
    val probs = softmax(logits);
    print("probs = ");
    print_list(probs);
    0
}
