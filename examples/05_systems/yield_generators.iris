// yield_generators.iris — Generator functions with yield
//
// Functions containing `yield` become generators that return a list.
// Each `yield value` appends the value to the result list, and the
// function can use loops and conditionals to control what gets yielded.
//
// Run: iris run examples/05_systems/yield_generators.iris

// Generate numbers 1..n
def count_to(n: i64) -> list<i64> {
    var i = 1;
    while i <= n {
        yield i;
        i = i + 1;
    }
}

// Generate even numbers up to max_val
def even_numbers(max_val: i64) -> list<i64> {
    var i = 2;
    while i <= max_val {
        yield i;
        i = i + 2;
    }
}

// Generate Fibonacci numbers up to a limit
def fibonacci(limit: i64) -> list<i64> {
    var a = 0;
    var b = 1;
    while a <= limit {
        yield a;
        val next = a + b;
        a = b;
        b = next;
    }
}

// Generate string labels
def labels(prefix: str, count: i64) -> list<str> {
    var i = 0;
    while i < count {
        yield concat(prefix, to_str(i));
        i = i + 1;
    }
}

// Conditional yield: only yield items matching a condition
def evens_only(max_val: i64) -> list<i64> {
    var i = 1;
    while i <= max_val {
        if i % 2 == 0 {
            yield i;
        }
        i = i + 1;
    }
}

// Nested yield: multiple loops
def grid_values(rows: i64, cols: i64) -> list<i64> {
    var r = 0;
    while r < rows {
        var c = 0;
        while c < cols {
            yield r * cols + c;
            c = c + 1;
        }
        r = r + 1;
    }
}

def main() -> i64 {
    print("=== Yield Generators ===");
    print("");

    // Basic counting generator
    val counts = count_to(5);
    print("count_to(5): " + to_str(len(counts)) + " items");

    // Even numbers
    val evens = even_numbers(20);
    print("even_numbers(20): " + to_str(len(evens)) + " items");
    print("  first=" + to_str(list_get(evens, 0)) + " last=" + to_str(list_get(evens, len(evens) - 1)));

    // Fibonacci
    val fibs = fibonacci(100);
    print("fibonacci(100): " + to_str(len(fibs)) + " items");
    var fi = 0;
    while fi < len(fibs) {
        print("  fib[" + to_str(fi) + "] = " + to_str(list_get(fibs, fi)));
        fi = fi + 1;
    }

    // String labels
    val labs = labels("item_", 4);
    print("labels('item_', 4):");
    var li = 0;
    while li < len(labs) {
        print("  " + to_str(list_get(labs, li)));
        li = li + 1;
    }

    // Conditional yield
    val evens2 = evens_only(10);
    print("evens_only(10): " + to_str(len(evens2)) + " items");

    // Nested yield
    val grid = grid_values(3, 4);
    print("grid_values(3,4): " + to_str(len(grid)) + " items");

    print("");
    print("yield generator example complete.");
    0
}
