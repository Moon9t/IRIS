bring std.fmt
def main() -> i64 {
    print("=== Concurrency Example ===");
    val ch = channel()
    val counter = atomic(0)
    spawn {
        var i = 1
        while i <= 5 {
            send(ch, i);
            atomic_add(counter, 1);
            i = i + 1;
            
        }
        
    }
    ;
    var total = 0
    var received = 0
    while received<5 {
        total = total + recv(ch);
        received = received + 1;
        
    }
    print(concat("messages received = ", to_str(received)));
    print(concat("message total = ", to_str(total)));
    print(concat("atomic counter = ", to_str(atomic_load(counter))));
    if received == 5 && total == 15 && atomic_load(counter) == 5 {
        0
    }
    else {
        1
    }
    
}
