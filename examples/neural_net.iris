// neural_net.iris -- small XOR-style network using current IRIS syntax.
//
// This example intentionally uses unannotated val/var declarations to show
// inferred immutable and inferred mutable bindings.

def sigmoid(x: f64) -> f64 {
    1.0 / (1.0 + exp(0.0 - x))
}

def relu(x: f64) -> f64 {
    if x > 0.0 {
        x
    } else {
        0.0
    }
}

def xor_net(x1: f64, x2: f64) -> f64 {
    val h1 = sigmoid(0.9 * x1 + 0.9 * x2 - 0.2);
    val h2 = sigmoid(0.9 * x1 + 0.9 * (1.0 - x2) - 0.2);
    relu(1.8 * h1 + 1.8 * h2 - 1.0)
}

def mse(pred: f64, target: f64) -> f64 {
    val diff = pred - target;
    diff * diff
}

def add_case(xs1: list<f64>, xs2: list<f64>, targets: list<f64>, x1: f64, x2: f64, target: f64) -> i64 {
    push(xs1, x1);
    push(xs2, x2);
    push(targets, target);
    0
}

def main() -> i64 {
    print("=== XOR Network ===");

    val p00 = xor_net(0.0, 0.0);
    val p01 = xor_net(0.0, 1.0);
    val p10 = xor_net(1.0, 0.0);
    val p11 = xor_net(1.0, 1.0);

    print(concat("pred(0,0) = ", to_str(p00)));
    print(concat("pred(0,1) = ", to_str(p01)));
    print(concat("pred(1,0) = ", to_str(p10)));
    print(concat("pred(1,1) = ", to_str(p11)));

    val xs1 : list<f64> = list();
    val xs2 : list<f64> = list();
    val targets : list<f64> = list();
    val _a = add_case(xs1, xs2, targets, 0.0, 0.0, 0.0);
    val _b = add_case(xs1, xs2, targets, 0.0, 1.0, 1.0);
    val _c = add_case(xs1, xs2, targets, 1.0, 0.0, 1.0);
    val _d = add_case(xs1, xs2, targets, 1.0, 1.0, 0.0);

    var total = 0.0;
    var i = 0;
    while i < list_len(xs1) {
        val x1 = list_get(xs1, i);
        val x2 = list_get(xs2, i);
        val target = list_get(targets, i);
        total = total + mse(xor_net(x1, x2), target);
        i = i + 1
    }

    val avg = total / 4.0;
    print(concat("xor loss = ", to_str(avg)));
    0
}
