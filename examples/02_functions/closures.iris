// closures.iris -- lambdas, closures, and higher-order functions
//
// Demonstrates actual lambda syntax (|params| body), passing
// closures as function arguments, and function composition.
//
// Run: iris run examples/closures.iris

// Higher-order function: apply a function to a value
def apply(f: (i64) -> i64, x: i64) -> i64 {
    f(x)
}

// Apply a function twice: f(f(x))
def apply_twice(f: (i64) -> i64, x: i64) -> i64 {
    f(f(x))
}

// Apply a function n times
def apply_n(f: (i64) -> i64, x: i64, n: i64) -> i64 {
    var result = x
    var i = 0
    while i < n {
        result = f(result);
        i = i + 1
    }
    result
}

// Transform every element in a list
def map_list_fn(lst: list<i64>, f: (i64) -> i64) -> list<i64> {
    val result = list()
    for item in lst {
        push(result, f(item))
    }
    result
}

// Filter elements that satisfy a predicate
def filter_fn(lst: list<i64>, pred: (i64) -> bool) -> list<i64> {
    val result = list()
    for item in lst {
        if pred(item) { push(result, item) } else { val _n = 0 }
    }
    result
}

// Fold/reduce a list
def fold_fn(lst: list<i64>, init: i64, f: (i64, i64) -> i64) -> i64 {
    var acc = init
    for item in lst {
        acc = f(acc, item)
    }
    acc
}

def print_list(label: str, lst: list<i64>) -> i64 {
    var s = "["
    var i = 0
    while i < list_len(lst) {
        s = concat(s, to_str(list_get(lst, i)));
        s = if (i + 1) < list_len(lst) { concat(s, ", ") } else { s };
        i = i + 1
    }
    print(concat(label, concat(s, "]")));
    0
}

def main() -> i64 {
    print("=== Lambda Expressions ===");

    val double  = |x: i64| x * 2
    val square  = |x: i64| x * x
    val negate  = |x: i64| 0 - x
    val add_one = |x: i64| x + 1

    print(concat("double(7)  = ", to_str(double(7))));
    print(concat("square(5)  = ", to_str(square(5))));
    print(concat("negate(3)  = ", to_str(negate(3))));

    print("\n=== Passing Lambdas ===");
    print(concat("apply(double, 21)        = ", to_str(apply(double, 21))));
    print(concat("apply(square, 6)         = ", to_str(apply(square, 6))));
    print(concat("apply_twice(double, 3)   = ", to_str(apply_twice(double, 3))));
    print(concat("apply_n(add_one, 0, 10)  = ", to_str(apply_n(add_one, 0, 10))));

    print("\n=== Map / Filter / Fold ===");
    val nums = list()
    push(nums, 1); push(nums, 2); push(nums, 3);
    push(nums, 4); push(nums, 5);

    print_list("Source:   ", nums);

    val doubled = map_list_fn(nums, double)
    print_list("Doubled:  ", doubled);

    val squared = map_list_fn(nums, square)
    print_list("Squared:  ", squared);

    val evens = filter_fn(nums, |x: i64| (x % 2) == 0)
    print_list("Evens:    ", evens);

    val big = filter_fn(nums, |x: i64| x > 3)
    print_list("x > 3:    ", big);

    val sum = fold_fn(nums, 0, |a: i64, b: i64| a + b)
    print(concat("Sum:      ", to_str(sum)));

    val product = fold_fn(nums, 1, |a: i64, b: i64| a * b)
    print(concat("Product:  ", to_str(product)));

    // Compose: sum of squares of evens
    val even_squares = map_list_fn(filter_fn(nums, |x: i64| (x % 2) == 0), square)
    val result = fold_fn(even_squares, 0, |a: i64, b: i64| a + b)
    print(concat("Sum of squares of evens: ", to_str(result)));

    print("\n=== Closure Capture ===");
    val base = 100
    val add_base = |x: i64| x + base
    print(concat("add_base(50) = ", to_str(add_base(50))));
    print(concat("apply(add_base, 25) = ", to_str(apply(add_base, 25))));

    0
}
