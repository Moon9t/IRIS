// A failing `check` must fail the run. It used to return 1, and the callers
// summed the results and dropped them -- and `--emit eval` ignores main's
// return value anyway (known-issues #53), so every check silently passed.
def check(b: bool) -> i64 { assert(b); 0 }

record Point { x: i64, y: i64 }
choice Color { Red, Green, Blue }
choice Shape { Circle(i64), Square(i64) }

trait Double { def double(x: i64) -> i64 }
impl Double for i64 { def double(x: i64) -> i64 { x * 2 } }

def add(a: i64, b: i64) -> i64 { a + b }
def greet(name: str = "iris") -> str { concat("hello ", name) }
def id[T](x: T) -> T { x }
def first[T, U](a: T, b: U) -> T { a }
def make_point(x: i64) -> Point { Point { x: x, y: x + 1 } }

def test_add_1() -> i64 { check(1 + 2 == 3) }
def test_add_2() -> i64 { check(10 + 5 == 15) }
def test_sub_1() -> i64 { check(9 - 4 == 5) }
def test_sub_2() -> i64 { check(3 - 8 == -5) }
def test_mul_1() -> i64 { check(3 * 4 == 12) }
def test_mul_2() -> i64 { check(7 * 0 == 0) }
def test_div_1() -> i64 { check(9 / 3 == 3) }
def test_div_2() -> i64 { check(20 / 4 == 5) }
def test_mod_1() -> i64 { check(10 % 3 == 1) }
def test_mod_2() -> i64 { check(14 % 5 == 4) }
def test_precedence_1() -> i64 { check(1 + 2 * 3 == 7) }
def test_precedence_2() -> i64 { check((1 + 2) * 3 == 9) }
def test_negation_1() -> i64 { check(0 - 5 == -5) }
def test_negation_2() -> i64 { check(-7 == -7) }
def test_cmp_lt() -> i64 { check(2 < 3) }
def test_cmp_le() -> i64 { check(3 <= 3) }
def test_cmp_gt() -> i64 { check(5 > 2) }
def test_cmp_ge() -> i64 { check(5 >= 5) }
def test_cmp_eq() -> i64 { check(4 == 4) }
def test_cmp_ne() -> i64 { check(4 != 5) }

def test_if_else() -> i64 {
    val x = if 1 < 2 { 3 } else { 4 }
    check(x == 3)
}

def test_if_else_nested() -> i64 {
    val x = if 1 > 2 { 0 } else { if 2 > 1 { 5 } else { 6 } }
    check(x == 5)
}

def test_while_sum() -> i64 {
    var i = 0
    var sum = 0
    while i < 5 {
        sum = sum + i
        i = i + 1
    }
    check(sum == 10)
}

def test_while_break() -> i64 {
    var i = 0
    while i < 10 {
        if i == 3 { break }
        i = i + 1
    }
    check(i == 3)
}

def test_while_continue() -> i64 {
    var i = 0
    var sum = 0
    while i < 5 {
        i = i + 1
        if i == 3 { continue }
        sum = sum + i
    }
    check(sum == 12)
}

def test_for_sum() -> i64 {
    var sum = 0
    for i in 0..5 {
        sum = sum + i
    }
    check(sum == 10)
}

def test_for_zero() -> i64 {
    var sum = 1
    for i in 0..0 {
        sum = 0
    }
    check(sum == 1)
}

def test_loop_break() -> i64 {
    var x = 0
    loop {
        x = 7
        break
    }
    check(x == 7)
}

def test_short_circuit_and() -> i64 { check((true && false) == false) }
def test_short_circuit_or() -> i64 { check((false || true) == true) }

def test_tuple_literal() -> i64 {
    val t = (1, 2)
    check(t.0 == 1)
}

def test_tuple_index() -> i64 {
    val t = (1, 2, 3)
    check(t.2 == 3)
}

def test_tuple_destructure() -> i64 {
    val (a, b) = (3, 4)
    check(a + b == 7)
}

def test_tuple_nested() -> i64 {
    val t = ((1, 2), 3)
    val a = t.0
    check(a.1 == 2)
}

def test_array_literal() -> i64 {
    val a = [1, 2, 3]
    check(a[0] == 1)
}

def test_array_index() -> i64 {
    val a = [5, 6, 7]
    check(a[2] == 7)
}

def test_array_store() -> i64 {
    var a = [1, 2, 3]
    a[1] = 9
    check(a[1] == 9)
}

def test_array_sum_loop() -> i64 {
    val a = [1, 2, 3, 4]
    var i = 0
    var sum = 0
    while i < 4 {
        sum = sum + a[i]
        i = i + 1
    }
    check(sum == 10)
}

def test_array_sum_for() -> i64 {
    val a = [1, 2, 3]
    var sum = 0
    for i in 0..3 {
        sum = sum + a[i]
    }
    check(sum == 6)
}

def test_array_reassign() -> i64 {
    var a = [1, 2, 3]
    a = [4, 5, 6]
    check(a[0] == 4)
}

def test_record_literal() -> i64 {
    val p = Point { x: 1, y: 2 }
    check(p.x + p.y == 3)
}

def test_record_field() -> i64 {
    val p = Point { x: 5, y: 7 }
    check(p.x == 5)
}

def test_record_return() -> i64 {
    val p = make_point(4)
    check(p.y == 5)
}

def test_choice_variant() -> i64 {
    val c = Color.Red
    val v = when c {
        Color.Red => 1,
        _ => 0,
    }
    check(v == 1)
}

def test_choice_when() -> i64 {
    val c = Color.Green
    val v = when c {
        Color.Red => 1,
        Color.Green => 2,
        Color.Blue => 3,
    }
    check(v == 2)
}

def test_choice_with_data() -> i64 {
    val s = Shape.Circle(3)
    val v = when s {
        Shape.Circle(r) => r,
        Shape.Square(x) => x,
    }
    check(v == 3)
}

def test_choice_payload_sum() -> i64 {
    val s = Shape.Square(4)
    val v = when s {
        Shape.Circle(r) => r,
        Shape.Square(x) => x + 1,
    }
    check(v == 5)
}

def test_option_when() -> i64 {
    val o = some(4)
    val v = when o {
        some(x) => x,
        none => 0,
    }
    check(v == 4)
}

def test_result_when() -> i64 {
    val r = ok(7)
    val v = when r {
        ok(x) => x,
        err(e) => 0,
    }
    check(v == 7)
}

def test_option_unwrap() -> i64 {
    val o = some(9)
    check(unwrap(o) == 9)
}

def test_function_call() -> i64 { check(add(2, 3) == 5) }
def test_default_param() -> i64 { check(greet() == "hello iris") }
def test_generic_identity() -> i64 { check(id(3) == 3) }
def test_generic_first() -> i64 { check(first(9, "x") == 9) }
def test_trait_double() -> i64 { check(double(21) == 42) }

def test_closure_basic() -> i64 {
    val f = |x: i64| x + 1
    check(f(4) == 5)
}

def test_closure_capture() -> i64 {
    val n = 5
    val f = |x: i64| x + n
    check(f(7) == 12)
}

def test_closure_two_params() -> i64 {
    val f = |a: i64, b: i64| a * b
    check(f(3, 4) == 12)
}

def test_string_len() -> i64 {
    val s = "hello"
    check(len(s) == 5)
}

def test_string_concat() -> i64 {
    val s = concat("a", "bc")
    check(len(s) == 3)
}
