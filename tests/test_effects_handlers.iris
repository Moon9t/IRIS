// Test effect masks and handlers.

extern def echo(s: str) -> str

def main() -> i64 {
    // Test 1: with pure { } mask — restricts effects
    val result: str = with pure {
        "hello"
    };
    println("mask result: " + result);

    // Test 2: handle with handler arm (simple replacement)
    val handled: str = handle {
        echo("world")
    } with {
        echo(s) => to_str(s)
    };
    println("handler result: " + handled);

    if result == "hello" {
        if handled == "world" {
            println("All effect tests passed!");
            0
        } else {
            println("FAIL: handled wrong: " + handled);
            1
        }
    } else {
        println("FAIL: mask wrong");
        1
    }
}
