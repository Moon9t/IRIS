// Test: Pattern Guards

choice Color { Red, Green, Blue }

def test_guard() -> i64 {
    val x = some(5)
    when x {
        some(v) if v > 3 => 1,
        some(v) => 2,
        none => 0,
    }
}

def test_guard_else() -> i64 {
    val x = some(2)
    when x {
        some(v) if v > 3 => 1,
        some(v) => 2,
        none => 0,
    }
}

def test_guard_multiple() -> i64 {
    val x = some(10)
    when x {
        some(v) if v < 5 => 1,
        some(v) if v < 15 => 2,
        some(v) => 3,
        none => 0,
    }
}

def test_guard_enum() -> i64 {
    val c = Color.Green
    when c {
        Color.Red => 1,
        Color.Green if true => 2,
        Color.Blue => 3,
    }
}

def test_guard_false() -> i64 {
    val x = some(5)
    when x {
        some(v) if v > 10 => 1,
        some(v) => 2,
        none => 0,
    }
}

def main() -> i64 {
    // Each helper must select the arm its guard admits. The file summed all
    // five and checked nothing, so any arms totalling 9 would have passed.
    assert(test_guard() == 1);           // guard true, first arm
    assert(test_guard_else() == 2);      // guard false, falls to the next arm
    assert(test_guard_multiple() == 2);  // second guard is the one that holds
    assert(test_guard_enum() == 2);      // guard on an enum variant
    assert(test_guard_false() == 2);     // guard false, binding arm instead
    println("pattern guards ok");
    0
}
