// c21 -- loop-carried variable type, known-issues #27. FIXED 2026-08-20.
//
// This file failed to compile with
//
//   error[E0202]: type mismatch: i64 vs f64 -- Br arg %55 to param %49
//
// The title of the issue, and the comment that used to be here, both blamed
// `adjacent` -- an i64 accumulator carried across a loop whose body compares
// two f64 values. That was wrong, and the accumulator was a red herring.
//
// The actual cause is that this function contains two loops that each declare
// `val r`: the first binds `random()` (f64), the last binds `random_range()`
// (i64). Loop bodies had no scoping, so the first `r` leaked into the
// enclosing scope, and the last loop's rebound-variable scan then found it and
// typed that loop's block parameter from the stale f64 binding. Renaming
// either `r` made the file compile, which is why dropping almost any part of
// the program appeared to "fix" it -- each edit happened to remove one of the
// two declarations.
//
// The minimal form of the defect is five lines and involves no accumulator,
// no random, and no list:
//
//   for i in 0..2 { val r = 1.5; assert(r > 0.0); };
//   for i in 0..2 { val r = 7;   assert(r == 7);  };
//
// See tests/test_loop_scope.iris for the regression test.

def main() -> i64 {
    seed(7);
    val seen: list<f64> = list();
    for i in 0..200 {
        val r = random();
        assert(r >= 0.0);
        assert(r < 1.0);
        list_push(seen, r);
    };
    var adjacent = 0;
    for i in 1..200 {
        if list_get(seen, i) != list_get(seen, i - 1) { adjacent = adjacent + 1; };
    };
    assert(adjacent == 199);
    seed(3);
    for i in 0..100 {
        val r = random_range(10, 20);
        assert(r >= 10);
        assert(r < 20);
    };
    println("c21 ok"); 0
}
