// c08 — trait objects x multiple impls x dispatch through a dyn binding.
//
// SCOPE NOTE — this file is INTERPRETER-ONLY, deliberately.
//
// `dyn Trait` has no native implementation: MakeTraitObject and DynCall are
// empty no-ops in the LLVM backend, so every value they should define dangles
// and the module fails verification with "use of undefined value"
// (known-issues #18b). The tree's own test_trait_object.iris fails natively
// for the same reason.
//
// Interpreted, a concrete value is coerced to a trait object at an *annotated
// binding* and nowhere else: passing a concrete value to a `dyn Trait`
// parameter fails at runtime, and pushing one into `list<dyn Trait>` fails at
// compile time (#18). A heterogeneous collection is the main reason trait
// objects exist, so this file is far narrower than it should be. It should
// grow, and gain a native run, when #18 is fixed.

record Cat { name: str }
record Dog { name: str }
record Robot { id: i64 }

trait Speaker {
    def speak(self) -> str
    def label(self) -> str
}

impl Speaker for Cat {
    def speak(self) -> str { "meow" }
    def label(self) -> str { self.name }
}

impl Speaker for Dog {
    def speak(self) -> str { "woof" }
    def label(self) -> str { self.name }
}

impl Speaker for Robot {
    def speak(self) -> str { "beep" }
    def label(self) -> str { "unit" }
}

// Takes an *already* trait-object value, which is the supported shape.
def describe(s: dyn Speaker) -> str {
    s.label() + " says " + s.speak()
}

def main() -> i64 {
    val c = Cat { name: "tom" }
    val d = Dog { name: "rex" }
    val r = Robot { id: 7 }

    // Direct (static) dispatch on the concrete types.
    assert(c.speak() == "meow");
    assert(d.speak() == "woof");
    assert(r.speak() == "beep");
    assert(c.label() == "tom");

    // Dynamic dispatch through annotated bindings — three impls, one trait.
    val sc: dyn Speaker = c
    val sd: dyn Speaker = d
    val sr: dyn Speaker = r
    assert(sc.speak() == "meow");
    assert(sd.speak() == "woof");
    assert(sr.speak() == "beep");

    // Passing an already-coerced trait object as an argument.
    assert(describe(sc) == "tom says meow");
    assert(describe(sd) == "rex says woof");
    assert(describe(sr) == "unit says beep");

    println("c08 ok");
    0
}
