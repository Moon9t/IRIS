// c08 — trait objects x multiple impls x dispatch through a dyn binding.
//
// `dyn Trait` now has a native backend (known-issues #18b), so this file runs
// on both `--emit eval` and `IRIS_FORCE_INTERP=1`. It was interpreter-only
// until 2026-08-16: `MakeTraitObject` and `DynCall` were empty no-ops in the
// LLVM backend, so every value they should have defined dangled and the module
// failed verification.
//
// Coercion now happens at three sites, not one: an annotated binding, a call
// argument, and a push into `list<dyn Trait>` (known-issues #18). The last is
// the one that matters -- a heterogeneous collection is the main reason trait
// objects exist, and until it worked the feature was close to decorative.

record Cat { name: str }
record Dog { name: str }
record Robot { id: i64 }

trait Speaker {
    def speak(self) -> str
    def label(self) -> str
}

impl Speaker for Cat {
    def speak(self) -> str { "meow" }
    def label(self) -> str { self.name }
}

impl Speaker for Dog {
    def speak(self) -> str { "woof" }
    def label(self) -> str { self.name }
}

impl Speaker for Robot {
    def speak(self) -> str { "beep" }
    def label(self) -> str { "unit" }
}

// Takes an *already* trait-object value, which is the supported shape.
def describe(s: dyn Speaker) -> str {
    s.label() + " says " + s.speak()
}

def main() -> i64 {
    val c = Cat { name: "tom" }
    val d = Dog { name: "rex" }
    val r = Robot { id: 7 }

    // Direct (static) dispatch on the concrete types.
    assert(c.speak() == "meow");
    assert(d.speak() == "woof");
    assert(r.speak() == "beep");
    assert(c.label() == "tom");

    // Dynamic dispatch through annotated bindings — three impls, one trait.
    val sc: dyn Speaker = c
    val sd: dyn Speaker = d
    val sr: dyn Speaker = r
    assert(sc.speak() == "meow");
    assert(sd.speak() == "woof");
    assert(sr.speak() == "beep");

    // Passing an already-coerced trait object as an argument.
    assert(describe(sc) == "tom says meow");
    assert(describe(sd) == "rex says woof");
    assert(describe(sr) == "unit says beep");

    // Passing a *concrete* value where `dyn Speaker` is expected. This used to
    // compile and then fail at runtime with "DynCall on non-trait-object",
    // deferring a compile-time-knowable mistake to execution (#18).
    assert(describe(c) == "tom says meow");
    assert(describe(d) == "rex says woof");
    assert(describe(Robot { id: 9 }) == "unit says beep");

    // The heterogeneous collection: three unrelated record types in one list,
    // dispatched by their own impls. This is the reason trait objects exist,
    // and it failed to compile at all until #18 was fixed.
    val zoo: list<dyn Speaker> = list()
    list_push(zoo, c);
    list_push(zoo, d);
    list_push(zoo, r);
    assert(list_len(zoo) == 3);
    assert(list_get(zoo, 0).speak() == "meow");
    assert(list_get(zoo, 1).speak() == "woof");
    assert(list_get(zoo, 2).speak() == "beep");

    // Iterating the collection dispatches per element rather than picking one
    // implementation and applying it to everything -- the failure a vtable bug
    // would most plausibly produce.
    val expected: list<str> = list()
    list_push(expected, "meow");
    list_push(expected, "woof");
    list_push(expected, "beep");
    for i in 0 .. 3 {
        assert(list_get(zoo, i).speak() == list_get(expected, i));
    };

    // And a trait object drawn out of the collection still works as a call
    // argument, so coercion is not lost on the way through the list.
    assert(describe(list_get(zoo, 0)) == "tom says meow");

    println("c08 ok");
    0
}
