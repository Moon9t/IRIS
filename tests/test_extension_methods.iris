// Test extension methods: module-level functions callable as methods.
def double(x: i64) -> i64 {
    x * 2
}

def add_prefix(s: str, prefix: str) -> str {
    prefix + s
}

record Point {
    x: i64,
    y: i64,
}

def distance_to(a: Point, b: Point) -> i64 {
    val dx = a.x - b.x;
    val dy = a.y - b.y;
    dx * dx + dy * dy
}

def main() -> i64 {
    // Test 1: extension method on i64
    val d = 21.double();
    println("21.double() = " + to_str(d));

    // Test 2: extension method on str with extra args
    val s = "world".add_prefix("hello ");
    println("add_prefix: " + s);

    // Test 3: extension method on struct type (not using impl)
    val p1 = Point { x: 0, y: 0 };
    val p2 = Point { x: 3, y: 4 };
    val dist = p1.distance_to(p2);
    println("distance = " + to_str(dist));

    assert(d == 42);
    assert(s == "hello world");
    // 3-4-5 triangle, squared distance: 9 + 16.
    assert(dist == 25);
    // A second receiver, so a method returning a constant cannot pass.
    assert(5.double() == 10);
    assert(p1.distance_to(p1) == 0);
    println("extension methods ok");
    0
}
