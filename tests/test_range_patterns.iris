// Test: Range Patterns in when expressions

def test_range_basic() -> i64 {
    val x = 7
    when x {
        1..=5 => 1,
        6..=10 => 2,
        11..=15 => 3,
        _ => 0,
    }
}

def test_range_edge() -> i64 {
    val x = 5
    when x {
        1..=5 => 1,  // inclusive start and end
        6..=10 => 2,
        _ => 0,
    }
}

def test_range_single() -> i64 {
    val x = 7
    when x {
        7..=7 => 42,
        _ => 0,
    }
}

def test_range_neg() -> i64 {
    val x = 3
    when x {
        1..=3 => 1,
        4..=10 => 2,
        _ => 0,
    }
}

def test_range_overlapping() -> i64 {
    // First matching arm wins
    val x = 5
    when x {
        1..=10 => 1,
        5..=5 => 2,
        _ => 0,
    }
}

def test_range_mixed() -> i64 {
    val x = 3
    when x {
        1 => 10,           // literal
        2..=4 => 20,       // range
        5..=10 => 30,      // range
        _ => 0,
    }
}

def main() -> i64 {
    // Each function returns the value of the arm its scrutinee falls in. The
    // file summed all six and checked nothing, so any set of arms adding to the
    // same total would have passed.
    assert(test_range_basic() == 2);        // 7 is in 6..=10
    assert(test_range_edge() == 1);         // 5 is the inclusive end of 1..=5
    assert(test_range_single() == 42);      // 7..=7 is a single-value range
    assert(test_range_neg() == 1);          // 3 is in 1..=3
    assert(test_range_overlapping() == 1);  // first matching arm wins, not 5..=5
    assert(test_range_mixed() == 20);       // 3 is in 2..=4, past the literal arm
    println("range patterns ok");
    0
}
