// A closure passed to a `|i64| -> i64` parameter must actually be invoked with
// the argument, not silently ignored.
def apply(f: |i64| -> i64, x: i64) -> i64 {
    f(x)
}

def main() -> i64 {
    val r1 = apply(|x: i64| x * 2, 7);
    println("apply result: " + to_str(r1));
    assert(r1 == 14);

    // A second shape, so a closure that ignored its argument and returned a
    // constant could not pass both.
    val r2 = apply(|x: i64| x + 100, 7);
    assert(r2 == 107);

    // Zero must survive: an implementation returning the default would give 0
    // here and look correct.
    assert(apply(|x: i64| x * 3, 0) == 0);
    0
}
