// Test: Or-patterns in when expressions

choice Color { Red, Green, Blue }
choice Dir { Up, Down, Left, Right }

def test_or_enum() -> i64 {
    val c = Color.Red
    when c {
        Color.Red | Color.Green => 1,
        Color.Blue => 2,
    }
}

def test_or_literal() -> i64 {
    val x = 3
    when x {
        1 | 2 | 3 => 10,
        4 | 5 => 20,
        _ => 0,
    }
}

def test_or_tuple() -> i64 {
    val t = (1, 2)
    when t {
        (1, _) | (_, 1) => 1,
        (_, _) => 2,
    }
}

def test_or_range() -> i64 {
    val x = 7
    when x {
        1..=3 | 5..=7 => 1,
        _ => 0,
    }
}

def main() -> i64 {
    test_or_enum() + test_or_literal() + test_or_tuple() + test_or_range()
}