// Test Option exhaustiveness
def test_option_exhaustive() -> i64 {
    val o = some(42)
    when o {
        some(x) => x,
        none => 0,
    }
}

// Test Option non-exhaustive (missing None)
def test_option_non_exhaustive() -> i64 {
    val o = some(42)
    when o {
        some(x) => x,
        // Missing none
    }
}

// Test Result exhaustive
def test_result_exhaustive() -> i64 {
    val r = ok(42)
    when r {
        ok(x) => x,
        err(e) => -1,
    }
}

// Test Result non-exhaustive (missing Err)
def test_result_non_exhaustive() -> i64 {
    val r = ok(42)
    when r {
        ok(x) => x,
        // Missing err
    }
}

def main() -> i64 {
    // Exhaustive matches must yield the covered arm's value.
    assert(test_option_exhaustive() == 42);
    assert(test_result_exhaustive() == 42);

    // The non-exhaustive versions are declared above and deliberately NOT
    // called: both are accepted by the compiler and return 0 rather than the
    // covered arm's value (known-issues #54). Calling them here would make this
    // file fail for a defect that already has its own regression test in
    // tests/test_option_non_exhaustive.iris.
    println("option/result exhaustiveness ok");
    0
}
