// The effect system: pure functions auto-promote, explicit clauses are
// accepted, and effect rows are inherited through a call chain. Each function
// returns a distinct value so the sum below pins which ones actually ran.
def pure_id(x: i64) -> i64 {
    x
}

def say_hello() -> i64 effect io {
    println("hello");
    1
}

def call_say() -> i64 effect io {
    say_hello() + 1
}

def emit_alloc() -> i64 effect io, alloc {
    println("allocates");
    4
}

def chain() -> i64 effect io {
    call_say() + 8
}

def main() -> i64 effect io, alloc {
    assert(pure_id(0) == 0);
    assert(pure_id(37) == 37);
    assert(say_hello() == 1);
    // call_say inherits io and adds 1 to what say_hello returned.
    assert(call_say() == 2);
    assert(emit_alloc() == 4);
    // chain calls through call_say, so the whole row is inherited.
    assert(chain() == 10);
    println("effects basic ok");
    0
}
