// Tail-recursive functions -- and an honest note about what this does NOT show.
//
// This file was called a tail-call-optimisation test and its comment claimed
// "deep recursion that would overflow the stack without TCO". It does not
// demonstrate TCO. There is no tail-call optimisation in either backend: the
// original `sum_to(50000)` runs only when the interpreter's depth limit is
// raised (`--max-depth 100000`), because it really does build 50,000 frames.
// With the default limit it stops with "call depth exceeded 250".
//
// A genuine TCO test would recurse unboundedly in constant stack. Until that
// exists, the depths here are kept inside the default limit and the file
// asserts that tail-recursive *arithmetic* is correct, which is what it can
// honestly check. See known-issues #35.

def factorial(n: i64, acc: i64) -> i64 {
    if n <= 1 {
        acc
    } else {
        factorial(n - 1, acc * n)
    }
}

def sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 {
        acc
    } else {
        sum_to(n - 1, acc + n)
    }
}

def gcd_tco(a: i64, b: i64) -> i64 {
    if b == 0 {
        a
    } else {
        gcd_tco(b, a % b)
    }
}

def main() -> i64 {
    // 12! = 479001600, the largest factorial that fits comfortably here.
    val f = factorial(12, 1);
    println("factorial(12) = " + to_str(f));
    assert(f == 479001600);

    // Base case must terminate rather than recursing forever.
    assert(factorial(1, 1) == 1);
    assert(factorial(0, 1) == 1);

    // sum_to(200) = 200 * 201 / 2 = 20100. Chosen to sit inside the default
    // interpreter depth limit; raising it is what the original relied on.
    val s = sum_to(200, 0);
    println("sum_to(200) = " + to_str(s));
    assert(s == 20100);
    assert(sum_to(0, 0) == 0);
    assert(sum_to(1, 0) == 1);

    // Euclid, which is genuinely tail-recursive and shallow.
    assert(gcd_tco(48, 18) == 6);
    assert(gcd_tco(18, 48) == 6);
    assert(gcd_tco(17, 5) == 1);
    assert(gcd_tco(9, 0) == 9);

    println("test_tco ok");
    0
}
