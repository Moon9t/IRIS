def main() -> i64 {
    val a = "x"
    val b = "cherry"
    val r1 = a > b
    println("x > cherry = " + to_str(r1));
    val r2 = "cherry" > "apple"
    println("cherry > apple = " + to_str(r2));
    val r3 = "banana" > "apple"
    println("banana > apple = " + to_str(r3));
    val r4 = "x" > "banana"
    println("x > banana = " + to_str(r4));
    0
}
