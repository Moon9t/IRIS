// Lexicographic `>` on strings.
def main() -> i64 {
    // 'x' > 'c', so the first character decides regardless of length.
    assert(("x" > "cherry") == true);
    assert(("cherry" > "apple") == true);
    assert(("banana" > "apple") == true);
    assert(("x" > "banana") == true);

    // And the converse direction, which the original never checked -- a
    // comparison stuck at `true` would have passed every case above.
    assert(("apple" > "cherry") == false);
    assert(("apple" > "x") == false);

    // Equal strings are not greater than each other.
    assert(("apple" > "apple") == false);
    // A prefix is less than the longer string that extends it.
    assert(("apple" > "app") == true);
    assert(("app" > "apple") == false);

    println("test_str_gt ok");
    0
}
