// Test arithmetic operator overloading via traits
record Vec2 { x: i64, y: i64 }

impl Add for Vec2 {
    def add(self, other: Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

impl Sub for Vec2 {
    def sub(self, other: Vec2) -> Vec2 {
        Vec2 { x: self.x - other.x, y: self.y - other.y }
    }
}

impl Mul for Vec2 {
    def mul(self, other: Vec2) -> Vec2 {
        Vec2 { x: self.x * other.x, y: self.y * other.y }
    }
}

def main() -> i64 {
    val a = Vec2 { x: 1, y: 2 };
    val b = Vec2 { x: 3, y: 4 };
    
    val sum = a + b;
    println("add: " + to_str(sum.x) + ", " + to_str(sum.y));
    assert(sum.x == 4);
    assert(sum.y == 6);
    
    val diff = b - a;
    println("sub: " + to_str(diff.x) + ", " + to_str(diff.y));
    assert(diff.x == 2);
    assert(diff.y == 2);
    
    val prod = a * b;
    println("mul: " + to_str(prod.x) + ", " + to_str(prod.y));
    assert(prod.x == 3);
    assert(prod.y == 8);
    
    // Operands in the other order, so a subtraction implemented as a - b vs
    // b - a cannot pass both.
    val diff2 = a - b;
    assert(diff2.x == -2);
    assert(diff2.y == -2);
    println("arithmetic operator overloading ok");
    0
}
