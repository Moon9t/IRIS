def check(b: bool) -> i64 { if b { 0 } else { 1 } }

async def add1(x: i64) -> i64 { x + 1 }
async def mul2(x: i64) -> i64 { x * 2 }
async def sum3(a: i64, b: i64, c: i64) -> i64 { a + b + c }
async def chain(x: i64) -> i64 {
    val a = await add1(x)
    val b = await mul2(a)
    b
}

def test_channel_send_recv_1() -> i64 {
    val ch = channel()
    send(ch, 1);
    check(recv(ch) == 1)
}

def test_channel_send_recv_2() -> i64 {
    val ch = channel()
    send(ch, 2);
    check(recv(ch) == 2)
}

