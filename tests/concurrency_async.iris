def test_atomic_load_initial() -> i64 {
    val a = atomic(0)
    check(atomic_load(a) == 0)
}

def test_atomic_store() -> i64 {
    val a = atomic(0);
    atomic_store(a, 5);
    check(atomic_load(a) == 5)
}

def test_atomic_add_1() -> i64 {
    val a = atomic(0);
    atomic_add(a, 1);
    check(atomic_load(a) == 1)
}

def test_atomic_add_2() -> i64 {
    val a = atomic(0);
    atomic_add(a, 2);
    check(atomic_load(a) == 2)
}

