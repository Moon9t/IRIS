def test_async_add1_1() -> i64 { check(await add1(1) == 2) }
def test_async_add1_2() -> i64 { check(await add1(2) == 3) }
def test_async_add1_3() -> i64 { check(await add1(3) == 4) }
def test_async_add1_4() -> i64 { check(await add1(4) == 5) }
def test_async_add1_5() -> i64 { check(await add1(5) == 6) }
def test_async_add1_6() -> i64 { check(await add1(6) == 7) }
def test_async_add1_7() -> i64 { check(await add1(7) == 8) }
def test_async_add1_8() -> i64 { check(await add1(8) == 9) }

def test_async_chain_1() -> i64 { check(await chain(1) == 4) }
def test_async_chain_2() -> i64 { check(await chain(2) == 6) }
def test_async_chain_3() -> i64 { check(await chain(3) == 8) }
def test_async_chain_4() -> i64 { check(await chain(4) == 10) }
def test_async_chain_5() -> i64 { check(await chain(5) == 12) }
def test_async_chain_6() -> i64 { check(await chain(6) == 14) }
def test_async_chain_7() -> i64 { check(await chain(7) == 16) }
def test_async_chain_8() -> i64 { check(await chain(8) == 18) }

def test_async_multi_await() -> i64 {
    val a = await add1(3)
    val b = await mul2(4)
    check(a + b == 12)
}

def test_async_sum3() -> i64 { check(await sum3(1, 2, 3) == 6) }

def test_async_await_loop() -> i64 {
    var i = 0
    var sum = 0
    while i < 3 {
        sum = sum + await add1(i)
        i = i + 1
    }
    check(sum == 6)
}

def test_async_no_await_recv() -> i64 {
    val ch = add1(5)
    check(recv(ch) == 6)
}

def test_barrier_basic() -> i64 {
    barrier();
    check(true)
}

def test_barrier_value() -> i64 {
    val x = 3
    barrier();
    check(x == 3)
}

def test_barrier_conditional() -> i64 {
    val x = 1
    if x == 1 {
        barrier();
        check(true)
    } else {
        check(false)
    }
}

def test_barrier_loop() -> i64 {
    var i = 0
    while i < 2 {
        barrier();
        i = i + 1
    }
    check(i == 2)
}

def test_par_for_atomic_1() -> i64 {
    val a = atomic(0)
    par for i in 0..4 {
        atomic_add(a, 1)
    }
    barrier();
    check(atomic_load(a) == 4)
}

def test_par_for_atomic_2() -> i64 {
    val a = atomic(0)
    par for i in 0..6 {
        atomic_add(a, 1)
    }
    barrier();
    check(atomic_load(a) == 6)
}

