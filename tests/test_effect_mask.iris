// Test: Effect mask isolation with `with pure { ... }`
// The body executes within an isolated effect mask row.

def compute(x: i64) -> i64 {
    val result = with pure {
        x * 2 + 10
    };
    result
}

def main() -> i64 {
    val r = compute(15);
    print(r);
    print("\n");
    if r == 40 { 0 } else { 1 }
}
