// Feature 23: Named keyword arguments
//
// This file used to print seven values and then "All named arg tests passed!"
// without asserting any of them. Every value it computed was wrong -- named
// arguments were parsed and then discarded by the lowerer, so each call was
// lowered with no arguments at all and the callee read stale registers. The
// test reported success for the entire life of the defect (known-issues #1).
//
// Every case now asserts.
def main() -> i64 {
    // Test 1: Basic named args (in order)
    val t1: i64 = add(a=3, b=4);
    println("t1=" + to_str(t1));
    assert(t1 == 7);

    // Test 2: Named args out of order
    val t2: i64 = add(b=10, a=5);
    println("t2=" + to_str(t2));
    assert(t2 == 15);

    // Test 3: Mix positional and named
    val t3: i64 = add(2, b=8);
    println("t3=" + to_str(t3));
    assert(t3 == 10);

    // Test 4: Named args with 3 params
    val t4: i64 = triply(x=4);
    println("t4=" + to_str(t4));
    assert(t4 == 12);

    // Test 5: Positional only (backward compat)
    val t5: i64 = add(7, 3);
    println("t5=" + to_str(t5));
    assert(t5 == 10);

    // Test 6: All named with 3 params
    val t6: i64 = scale(x=3, y=5, z=2);
    println("t6=" + to_str(t6));
    assert(t6 == 30);

    // Test 7: All named
    val t7: i64 = add(a=100, b=200);
    println("t7=" + to_str(t7));
    assert(t7 == 300);

    // Test 8: order of evaluation follows the parameter, not the call site.
    // Reordering the call must not reorder the arguments -- `sub(b=1, a=10)`
    // is 10 - 1, not 1 - 10. A resolver that appended named args in written
    // order rather than parameter order would pass every test above and fail
    // this one.
    assert(sub(b=1, a=10) == 9);
    assert(sub(a=10, b=1) == 9);
    assert(sub(10, b=1) == 9);
    assert(sub(10, 1) == 9);

    // Test 9: non-commutative with three parameters, fully shuffled.
    assert(shuffle(c=3, a=1, b=2) == 100 * 1 + 10 * 2 + 3);

    println("All named arg tests passed!");
    return 0
}

def add(a: i64, b: i64) -> i64 {
    return a + b
}

def sub(a: i64, b: i64) -> i64 {
    return a - b
}

def shuffle(a: i64, b: i64, c: i64) -> i64 {
    return a * 100 + b * 10 + c
}

def triply(x: i64) -> i64 {
    return add(x, add(x, x))
}

def scale(x: i64, y: i64, z: i64) -> i64 {
    return x * y * z
}
