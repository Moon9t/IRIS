// Generic records with explicit type annotations, at more than one
// instantiation so a single specialisation cannot serve both.
record Box[T] {
    item: T
}

record Pair[T, U] {
    first: T,
    second: U
}

def main() -> i64 {
    val b: Box<i64> = Box { item: 42 }
    assert(b.item == 42);

    val bs: Box<str> = Box { item: "hello" }
    assert(bs.item == "hello");

    val p: Pair<i64, i64> = Pair { first: 10, second: 20 }
    assert(p.first == 10);
    assert(p.second == 20);
    // Distinct field values, so a record storing one value for both fields
    // would fail rather than pass on type alone.
    assert(p.first != p.second);

    // A heterogeneous pair: the two parameters must stay independent.
    val ps: Pair<str, i64> = Pair { first: "k", second: 7 }
    assert(ps.first == "k");
    assert(ps.second == 7);
    println("generic records ok");
    0
}
