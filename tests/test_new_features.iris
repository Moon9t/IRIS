def safe_divide(a: i64, b: i64) -> result<i64, str> {
    if b == 0 { return err("div by zero") }
    return ok(a / b)
}

def test_try_catch() -> i64 {
    val r: i64 = try {
        val v = safe_divide(10, 2)?;
        v
    } catch e { -1 };
    val r2: i64 = try {
        val v = safe_divide(10, 0)?;
        v
    } catch e { -1 };
    val r3: i64 = try {
        val v = try {
            safe_divide(10, 0)?;
        } catch e2 { -2 };
        v
    } catch e { -3 };
    if r != 5 { return 1 };
    if r2 != -1 { return 2 };
    if r3 != -2 { return 3 };
    0
}

def test_list_comprehension() -> i64 {
    0
}

def add_three(a: i64, b: i64, c: i64) -> i64 {
    a + b + c
}

def test_splat() -> i64 {
    val args = [10, 20, 30];
    val result = add_three(..args);
    val extra = [20, 30];
    val result2 = add_three(10, ..extra);
    if result != 60 { return 1 };
    if result2 != 60 { return 2 };
    0
}

def test_char_and_raw_string() -> i64 {
    val ch: u8 = 'A';
    val newline: u8 = '\n';
    val raw = r"hello\nworld";
    val ch2: u8 = 'B';
    if ch != 65 { return 1 };
    if newline != 10 { return 2 };
    if raw != "hello\\nworld" { return 3 };
    if ch == ch2 { return 4 };
    0
}

def count_to(n: i64) -> list<i64> {
    var i = 1;
    while i <= n {
        yield i;
        i = i + 1;
    }
}

def even_numbers(max_val: i64) -> list<i64> {
    var i = 2;
    while i <= max_val {
        yield i;
        i = i + 2;
    }
}

def test_yield_generators() -> i64 {
    val counts = count_to(5);
    val evens = even_numbers(10);
    if len(counts) != 5 { return 1 };
    if list_get(counts, 0) != 1 { return 2 };
    if list_get(counts, 4) != 5 { return 3 };
    if len(evens) != 5 { return 4 };
    if list_get(evens, 0) != 2 { return 5 };
    if list_get(evens, 4) != 10 { return 6 };
    0
}

def main() -> i64 effect io, alloc {
    var failures = 0;
    val r1 = test_try_catch();
    if r1 != 0 { println("try/catch FAILED"); failures = failures + 1 };
    if r1 == 0 { println("try/catch PASSED") };
    val r2 = test_list_comprehension();
    if r2 != 0 { println("list comprehension FAILED"); failures = failures + 1 };
    if r2 == 0 { println("list comprehension PASSED") };
    val r3 = test_splat();
    if r3 != 0 { println("splat FAILED"); failures = failures + 1 };
    if r3 == 0 { println("splat PASSED") };
    val r4 = test_char_and_raw_string();
    if r4 != 0 { println("char/raw string FAILED"); failures = failures + 1 };
    if r4 == 0 { println("char/raw string PASSED") };
    val r5 = test_yield_generators();
    if r5 != 0 { println("yield generators FAILED"); failures = failures + 1 };
    if r5 == 0 { println("yield generators PASSED") };
    if failures == 0 { println("ALL TESTS PASSED") };
    if failures != 0 { println(concat(to_str(failures), " test suite(s) FAILED")) };
    failures
}
