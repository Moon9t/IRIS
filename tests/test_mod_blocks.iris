mod math {
    pub def add(a: i64, b: i64) -> i64 {
        a + b
    }
    pub def mul(a: i64, b: i64) -> i64 {
        a * b
    }
}

mod greeting {
    pub def hello() -> str {
        "hello"
    }
}

def main() -> i64 {
    val sum = math__add(2, 3);
    println("math.add = " + to_str(sum));

    val prod = math__mul(4, 5);
    println("math.mul = " + to_str(prod));

    val g = greeting__hello();
    println("greeting.hello = " + g);

    assert(sum == 5);
    assert(prod == 20);
    assert(g == "hello");
    // Asymmetric arguments, so add and mul cannot be confused.
    assert(math__add(10, 1) == 11);
    assert(math__mul(10, 1) == 10);
    println("module blocks ok");
    0
}
