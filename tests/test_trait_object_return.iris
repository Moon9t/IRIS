// Phase 91: Trait Objects — function returning dyn Trait (use coerced return)

record Cat {
    name: str,
}

record Dog {
    name: str,
}

trait Pet {
    def name(self) -> str
}

impl Pet for Cat {
    def name(self) -> str {
        self.name
    }
}

impl Pet for Dog {
    def name(self) -> str {
        self.name
    }
}

// Wrap a concrete Cat into a Pet via an if-expression that returns one branch.
def return_cat() -> dyn Pet {
    val c: Cat = Cat { name: "Whiskers" };
    return c
}

def return_dog() -> dyn Pet {
    val d: Dog = Dog { name: "Rex" };
    return d
}

def main() -> i64 {
    // A function returning `dyn Pet` must carry the concrete type's vtable, so
    // each factory's own name comes back.
    val c: dyn Pet = return_cat();
    assert(c.name() == "Whiskers");
    val d: dyn Pet = return_dog();
    assert(d.name() == "Rex");
    // Both must be reachable: a vtable stuck on one impl would fail the other.
    assert(c.name() != d.name());
    println("trait object return ok");
    0
}
