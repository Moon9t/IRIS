// Effect masks: `with pure { ... }` and `with io, alloc { ... }` must yield the
// body's value rather than a placeholder.
def emit(s: str) -> i64 effect io {
    println(s);
    3
}

def pure_compute() -> i64 {
    42
}

def masked_pure() -> i64 {
    with pure {
        pure_compute()
    }
}

def masked_io_alloc() -> i64 {
    with io, alloc {
        emit("masked")
    }
}

def main() -> i64 {
    assert(masked_pure() == 42);
    // The io body returns 3, not 0 -- a mask that discarded its body's value
    // would look correct if the body happened to return 0.
    assert(masked_io_alloc() == 3);
    println("effect masks ok");
    0
}
