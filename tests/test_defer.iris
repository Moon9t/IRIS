// `defer` must run its call when the function exits, on both the `return` path
// and the tail-expression path.
//
// The original printed "cleanup: ..." lines and checked nothing, so it would
// have passed identically if defer had never fired. The cleanup now records
// into a list owned by the caller, which makes execution observable.
def cleanup(log: list<str>, name: str) -> i64 {
    list_push(log, name);
    0
}

def test_return(log: list<str>) -> i64 {
    defer cleanup(log, "first");
    defer cleanup(log, "second");
    return 42
}

def test_tail(log: list<str>) -> i64 {
    defer cleanup(log, "tail-cleanup");
    99
}

def main() -> i64 {
    val log: list<str> = list();

    assert(test_return(log) == 42);
    // Both deferred calls must have run by the time the function returned.
    assert(list_len(log) == 2);

    val log2: list<str> = list();
    assert(test_tail(log2) == 99);
    // The tail-expression path defers too.
    assert(list_len(log2) == 1);
    assert(list_get(log2, 0) == "tail-cleanup");

    println("defer ok");
    0
}
