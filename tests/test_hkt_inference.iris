// Higher-kinded types: inferring the constructor `F` from an argument.
//
// This is the half of HKT that did not work at all. `def f[F[_], T](c: F<T>)`
// called with a `list<i64>` failed with "cannot infer type parameter T -- no
// argument mentions it", even though the parameter type `F<T>` plainly
// mentions it. Two causes, both in the monomorphiser:
//
//   * `extract_from_ast_type` had no case for a higher-kinded parameter, and
//     its caller filtered HKT parameters out of the names it was allowed to
//     bind -- so `F` could never be bound at all;
//   * substitution could only rebuild a user record (`Box__i64`), so even a
//     bound `F` produced a struct name defined nowhere when `F` was a builtin
//     constructor.
//
// A constructor now binds to a marker, and `F<T>` rebuilds `list<T>`,
// `option<T>` or `map<K,V>` directly. See known-issues #36.
//
// A multi-parameter HKT record (`W[F[_], A]`) is deliberately NOT exercised
// here: it works most of the time but remains non-deterministic through the
// mangled-name ordering in #21, and a flaky test is worse than no test.

def count[F[_], T](c: F<T>) -> i64 { 1 }
def ident[F[_], T](c: F<T>) -> F<T> { c }

def main() -> i64 {
    // F = list, T = i64. The constructor is recovered from the argument.
    val nums: list<i64> = list();
    list_push(nums, 1);
    list_push(nums, 2);
    assert(count(nums) == 1);

    // `ident` returns `F<T>`, so the constructor has to survive substitution
    // and rebuild a real `list<i64>` -- not a struct named `list__i64`.
    val r1 = ident(nums);
    assert(list_len(r1) == 2);
    assert(list_get(r1, 0) == 1);
    assert(list_get(r1, 1) == 2);

    // F = option: a different constructor through the same function.
    val o: option<i64> = some(42);
    assert(count(o) == 1);
    val r2 = ident(o);
    assert(is_some(r2));
    assert(unwrap(r2) == 42);

    // Same constructor, different element type.
    val os: option<str> = some("hi");
    assert(unwrap(ident(os)) == "hi");

    // Same element type, different constructor.
    val strs: list<str> = list();
    list_push(strs, "a");
    assert(list_get(ident(strs), 0) == "a");

    // Earlier instantiations are undisturbed by later ones -- the failure a
    // monomorphiser reusing one specialisation would produce.
    assert(list_get(r1, 0) == 1);
    assert(unwrap(r2) == 42);

    println("test_hkt_inference ok");
    0
}
