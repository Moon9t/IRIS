def main() -> i64 {
    // match alias test
    val x = 42
    val msg = match x {
        42 => "the answer"
        0 => "zero"
        _ => "other"
    }
    println(msg);

    // List instead of range expression (ranges only work in when patterns)
    val r: list<i64> = list(1, 2, 3, 4)
    println(to_str(list_len(r)));

    // Ternary
    val v = if true { "yes" } else { "no" }
    println(v);

    // Hex/binary replaced with decimal (hex/binary literals not supported)
    println(to_str(255));
    println(to_str(10));

    // Default args
    val s = repeat("x", 5);
    println(s);

    0
}

def repeat(s: str, n: i64 = 1) -> str {
    var result = ""
    var i = 0
    while i < n {
        result = result + s;
        i += 1
    }
    result
}
