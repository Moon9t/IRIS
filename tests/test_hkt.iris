// Higher-kinded types: `record Wrapper[F[_], A] { value: F<A> }`.
//
// This is the form that works: the type arguments are written out at the
// binding, so `F<A>` becomes `Box<i64>` and monomorphises to `Box__i64`.
// Inferring `F` from an argument does NOT work -- see known-issues #36 and the
// note in test_box_test.iris.

record Box[T] {
    item: T
}

record Wrapper[F[_], A] {
    value: F<A>
}

def main() -> i64 {
    // F is Box, A is i64.
    val w: Wrapper<Box, i64> = Wrapper {
        value: Box { item: 100 }
    }
    print("Wrapper[Box, i64].value.item = ");
    println(to_str(w.value.item));
    assert(w.value.item == 100);

    // A second instantiation at a different A, to catch one specialisation
    // being reused for both.
    val ws: Wrapper<Box, str> = Wrapper {
        value: Box { item: "hi" }
    }
    assert(ws.value.item == "hi");
    assert(w.value.item == 100);

    println("test_hkt ok");
    0
}
