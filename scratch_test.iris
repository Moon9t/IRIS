bring std.rl

def main() -> i64 {
    var buf = replay_buffer_new(2);
    val s1 : list<f64> = list();
    val _ = list_push(s1, 1.0);
    val e1 = Experience { state: s1, action: 1, reward: 0.5, next_state: s1, done: false };
    buf = replay_buffer_push(buf, e1);
    print(concat("buf.size = ", to_str(buf.size)));
    0
}
