) -> bool\\nCheck if value is infinite\",","highlight_start":1,"highlight_end":90},{"text":"        \"list_map\"           => \"def list_map(xs: list<T>, f: fn(T)->U) -> list<U>\\nApply function to each element\",","highlight_start":1,"highlight_end":117},{"text":"        \"list_filter\"        => \"def list_filter(xs: list<T>, f: fn(T)->bool) -> list<T>\\nKeep elements where f returns true\",","highlight_start":1,"highlight_end":127},{"text":"        \"list_reduce\"        => \"def list_reduce(xs: list<T>, init: U, f: fn(U,T)->U) -> U\\nFold list from left\",","highlight_start":1,"highlight_end":114},{"text":"        \"list_any\"           => \"def list_any(xs: list<T>) -> bool\\nTrue if any element is truthy\",","highlight_start":1,"highlight_end":100},{"text":"        \"list_all\"           => \"def list_all(xs: list<T>) -> bool\\nTrue if all elements are truthy\",","highlight_start":1,"highlight_end":102},{"text":"        \"list_zip\"           => \"def list_zip(a: list<T>, b: list<U>) -> list<(T,U)>\\nZip two lists into list of tuples\",","highlight_start":1,"highlight_end":122},{"text":"        \"list_enumerate\"     => \"def list_enumerate(xs: list<T>) -> list<(i64,T)>\\nPair each element with its index\",","highlight_start":1,"highlight_end":118},{"text":"        \"list_flatten\"       => \"def list_flatten(xs: list<list<T>>) -> list<T>\\nFlatten nested list one level\",","highlight_start":1,"highlight_end":113},{"text":"        \"list_unique\"        => \"def list_unique(xs: list<T>) -> list<T>\\nRemove duplicate elements\",","highlight_start":1,"highlight_end":102},{"text":"        \"list_reverse\"       => \"def list_reverse(xs: list<T>) -> list<T>\\nReturn reversed copy of list\",","highlight_start":1,"highlight_end":106},{"text":"        \"list_sorted\"        => \"def list_sorted(xs: list<T>) -> list<T>\\nReturn sorted copy of list\",","highlight_start":1,"highlight_end":103},{"text":"        \"list_sum\"           => \"def list_sum(xs: list<num>) -> f64\\nSum all numeric elements\",","highlight_start":1,"highlight_end":96},{"text":"        \"list_min\"           => \"def list_min(xs: list<T>) -> T\\nReturn minimum element\",","highlight_start":1,"highlight_end":90},{"text":"        \"list_max\"           => \"def list_max(xs: list<T>) -> T\\nReturn maximum element\",","highlight_start":1,"highlight_end":90},{"text":"        \"list_index_of\"      => \"def list_index_of(xs: list<T>, val: T) -> i64\\nIndex of first occurrence, or -1\",","highlight_start":1,"highlight_end":115},{"text":"        \"list_count\"         => \"def list_count(xs: list<T>, val: T) -> i64\\nCount occurrences of value\",","highlight_start":1,"highlight_end":106},{"text":"        \"list_take\"          => \"def list_take(xs: list<T>, n: i64) -> list<T>\\nTake first n elements\",","highlight_start":1,"highlight_end":104},{"text":"        \"list_drop\"          => \"def list_drop(xs: list<T>, n: i64) -> list<T>\\nDrop first n elements\",","highlight_start":1,"highlight_end":104},{"text":"        _ => return None,","highlight_start":1,"highlight_end":26},{"text":"    };","highlight_start":1,"highlight_end":7},{"text":"    Some(","highlight_start":1,"highlight_end":10},{"text":"        format!(","highlight_start":1,"highlight_end":17},{"text":"            \"```iris\\n{}\\n```\",","highlight_start":1,"highlight_end":32},{"text":"            sig.split_once('\\n').map(|(s, _)| s).unwrap_or(sig)","highlight_start":1,"highlight_end":64},{"text":"        )","highlight_start":1,"highlight_end":10},{"text":"        .to_owned()","highlight_start":1,"highlight_end":20},{"text":"            + &sig","highlight_start":1,"highlight_end":19},{"text":"                .split_once('\\n')","highlight_start":1,"highlight_end":34},{"text":"                .map(|(_, d)| format!(\"\\n\\n{}\", d))","highlight_start":1,"highlight_end":52},{"text":"                .unwrap_or_default(),","highlight_start":1,"highlight_end":38},{"text":"    )","highlight_start":1,"highlight_end":6},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Returns hover info for a keyword.","highlight_start":1,"highlight_end":38},{"text":"fn keyword_hover(name: &str) -> Option<String> {","highlight_start":1,"highlight_end":49},{"text":"    let info = match name {","highlight_start":1,"highlight_end":28},{"text":"        \"def\" => \"**def** — Define a function\",","highlight_start":1,"highlight_end":48},{"text":"        \"pub\" => \"**pub** — Export a function or record for use from other files\",","highlight_start":1,"highlight_end":83},{"text":"        \"val\" => \"**val** - inferred immutable binding (cannot be reassigned)\",","highlight_start":1,"highlight_end":80},{"text":"        \"var\" => \"**var** - inferred mutable binding (can be reassigned)\",","highlight_start":1,"highlight_end":75},{"text":"        \"if\" => \"**if** — Conditional expression: `if cond { ... } else { ... }`\",","highlight_start":1,"highlight_end":83},{"text":"        \"else\" => \"**else** — Alternative branch of an if expression\",","highlight_start":1,"highlight_end":71},{"text":"        \"while\" => \"**while** — Loop while condition is true\",","highlight_start":1,"highlight_end":63},{"text":"        \"for\" => \"**for** — Range loop: `for i in start..end { ... }`\",","highlight_start":1,"highlight_end":72},{"text":"        \"loop\" => \"**loop** — Infinite loop (break to exit)\",","highlight_start":1,"highlight_end":62},{"text":"        \"break\" => \"**break** — Exit the innermost loop\",","highlight_start":1,"highlight_end":58},{"text":"        \"continue\" => \"**continue** — Skip to the next loop iteration\",","highlight_start":1,"highlight_end":72},{"text":"        \"return\" => \"**return** — Early return from a function\",","highlight_start":1,"highlight_end":65},{"text":"        \"when\" => \"**when** — Pattern match expression\",","highlight_start":1,"highlight_end":57},{"text":"        \"record\" => \"**record** — Define a struct type with named fields\",","highlight_start":1,"highlight_end":75},{"text":"        \"choice\" => \"**choice** — Define an enum type with variants\",","highlight_start":1,"highlight_end":70},{"text":"        \"model\" => \"**model** - Define a model DSL graph\",","highlight_start":1,"highlight_end":59},{"text":"        \"layer\" => \"**layer** - Add an operation inside a model\",","highlight_start":1,"highlight_end":66},{"text":"        \"input\" => \"**input** - Declare a model input\",","highlight_start":1,"highlight_end":56},{"text":"        \"output\" => \"**output** - Declare a model output\",","highlight_start":1,"highlight_end":59},{"text":"        \"const\" => \"**const** — Compile-time constant\",","highlight_start":1,"highlight_end":56},{"text":"        \"type\" => \"**type** — Type alias\",","highlight_start":1,"highlight_end":43},{"text":"        \"extern\" => \"**extern** — Declare an external C function\",","highlight_start":1,"highlight_end":67},{"text":"        \"bring\" => \"**bring** — Import a module: `bring std.math`\",","highlight_start":1,"highlight_end":68},{"text":"        \"trait\" => \"**trait** — Define a trait (interface)\",","highlight_start":1,"highlight_end":61},{"text":"        \"impl\" => \"**impl** — Implement a trait for a type\",","highlight_start":1,"highlight_end":61},{"text":"        \"spawn\" => \"**spawn** — Launch a concurrent task\",","highlight_start":1,"highlight_end":59},{"text":"        \"par\" => \"**par** — Parallel execution: `par for i in 0..n { ... }`\",","highlight_start":1,"highlight_end":78},{"text":"        \"async\" => \"**async** — Mark a function as asynchronous\",","highlight_start":1,"highlight_end":66},{"text":"        \"await\" => \"**await** — Wait for an async expression to complete\",","highlight_start":1,"highlight_end":75},{"text":"        \"in\" => \"**in** - Introduce a range or iterator source in a loop\",","highlight_start":1,"highlight_end":75},{"text":"        \"to\" => \"**to** - Cast expression to a target type\",","highlight_start":1,"highlight_end":61},{"text":"        \"true\" => \"```iris\\ntrue: bool\\n```\",","highlight_start":1,"highlight_end":46},{"text":"        \"false\" => \"```iris\\nfalse: bool\\n```\",","highlight_start":1,"highlight_end":48},{"text":"        \"none\" => \"```iris\\nnone: option<T>\\n```\\nAbsent value\",","highlight_start":1,"highlight_end":65},{"text":"        _ => return None,","highlight_start":1,"highlight_end":26},{"text":"    };","highlight_start":1,"highlight_end":7},{"text":"    Some(info.to_owned())","highlight_start":1,"highlight_end":26},{"text":"}","highlight_start":1,"highlight_end":2},{"text":"","highlight_start":1,"highlight_end":1},{"text":"// ---------------------------------------------------------------------------","highlight_start":1,"highlight_end":79},{"text":"// Simple formatter","highlight_start":1,"highlight_end":20},{"text":"// ---------------------------------------------------------------------------","highlight_start":1,"highlight_end":79},{"text":"","highlight_start":1,"highlight_end":1},{"text":"/// Token-stream based IRIS formatter. Normalises indentation and spacing.","highlight_start":1,"highlight_end":75},{"text":"fn format_iris(source: &str) -> String {","highlight_start":1,"highlight_end":41},{"text":"    use crate::parser::lexer::{Lexer, Token};","highlight_start":1,"highlight_end":46},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    let spanned_tokens = match Lexer::new(source).tokenize() {","highlight_start":1,"highlight_end":63},{"text":"        Ok(t) => t,","highlight_start":1,"highlight_end":20},{"text":"        Err(_) => return source.to_owned(),","highlight_start":1,"highlight_end":44},{"text":"    };","highlight_start":1,"highlight_end":7},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    let mut out = String::with_capacity(source.len() + 64);","highlight_start":1,"highlight_end":60},{"text":"    let mut indent = 0usize;","highlight_start":1,"highlight_end":29},{"text":"    let mut at_line_start = true;","highlight_start":1,"highlight_end":34},{"text":"    let mut prev_was_newline = false;","highlight_start":1,"highlight_end":38},{"text":"    let mut blank_lines = 0usize;","highlight_start":1,"highlight_end":34},{"text":"    let mut prev_tok_was_pub = false;","highlight_start":1,"highlight_end":38},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    // Helper: emit current indentation.","highlight_start":1,"highlight_end":41},{"text":"    let indent_str = |depth: usize| \"    \".repeat(depth);","highlight_start":1,"highlight_end":58},{"text":"","highlight_start":1,"highlight_end":1},{"text":"    // Top-level item starters that get a blank line before them.","highlight_start":1,"highlight_end":66},{"text":"    let is_top_level_kw = |t: &Token| {","highlight_start":1,"highlight_end":40},{"text":"        matches!(","highlight_start":1,"highlight_end":18},{"text":"            t,","highlight_start":1,"highlight_end":15},{"text":"            Token::Def","highlight_start":1,"highlight_end":23},{"text":"                | Token::Record","highlight_start":1,"highlight_end":32},{"text":"                | Token::Choice","highlight_start":1,"highlight_end":32},{"text":"                | Token::Model","highlight_start":1,"highlight_end":31},{"text":"                | Token::Const","highlight_start":1,"highlight_end":31},{"text":"                | Token::Type","highlight_start":1,"highlight_end":30},{"text":"                | Token::Extern","highlight_start":1,"highlight_end":32},{"text":"                | Token::Trait","highlight_start":1,"highlight_end":31},{"text":"                | Token::Impl","highlight_start":1,"highlight_end":30},{"text":"                | Token::Pub","highlight_start":1,"highlight_end":29},{"text":"        )","highlight_start":1,"highlight_end":10},{"text":"    };","highlight_start":1,"highlight_end":7},{"text":"","highlight_start":1,"highlight_end":1},{"text