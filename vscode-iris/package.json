{
  "name": "iris-lang",
  "displayName": "IRIS Language",
  "description": "IRIS compiler: syntax highlighting, LSP, debugging, and REPL — Go-like developer experience",
  "version": "1.0.3",
  "publisher": "iris-lang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "iris",
    "iris-lang",
    "compiler",
    "llvm",
    "machine learning",
    "dsl",
    "language server",
    "debugger",
    "repl"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/moon9t/iris"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iris",
        "aliases": ["IRIS", "Iris", "iris"],
        "extensions": [".iris"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "iris",
        "scopeName": "source.iris",
        "path": "./syntaxes/iris.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "iris",
        "label": "IRIS Debugger",
        "languages": ["iris"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .iris file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line on launch.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "iris",
            "request": "launch",
            "name": "Debug IRIS File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "IRIS: Debug File",
            "description": "Debug the currently open .iris file",
            "body": {
              "type": "iris",
            "request": "launch",
            "name": "Debug ${1:File}",
            "program": "${file}",
            "stopOnEntry": false
          }
        }
      ]
      }
    ],
    "problemMatchers": [
      {
        "name": "iris",
        "owner": "iris",
        "source": "iris",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(error|warning)(?:\\[([A-Z]\\d+)\\])?:\\s+(.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*-->\\s+(.+):(\\d+):(\\d+)\\s*$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "iris",
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "description": "The IRIS command to run (run, build, test)."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "iris.runTest",
        "title": "IRIS: Run Test Function"
      },
      {
        "command": "iris.debugTest",
        "title": "IRIS: Debug Test Function"
      },
      {
        "command": "iris.runFile",
        "title": "IRIS: Run File",
        "icon": "$(play)"
      },
      {
        "command": "iris.buildFile",
        "title": "IRIS: Build Binary",
        "icon": "$(package)"
      },
      {
        "command": "iris.debugFile",
        "title": "IRIS: Debug File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "iris.openRepl",
        "title": "IRIS: Open REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "iris.restartLsp",
        "title": "IRIS: Restart Language Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "iris.stopLsp",
        "title": "IRIS: Stop Language Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "iris.showIR",
        "title": "IRIS: Show IR Output",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "iris.showLLVM",
        "title": "IRIS: Show LLVM IR Output",
        "icon": "$(symbol-class)"
      },
      {
        "command": "iris.showVersion",
        "title": "IRIS: Show Version Info",
        "icon": "$(info)"
      },
      {
        "command": "iris.showEmit",
        "title": "IRIS: Show Compiler Output...",
        "icon": "$(file-binary)"
      },
      {
        "command": "iris.showGraph",
        "title": "IRIS: Show Graph Output",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "iris.showCuda",
        "title": "IRIS: Show CUDA Output",
        "icon": "$(chip)"
      },
      {
        "command": "iris.showSimd",
        "title": "IRIS: Show SIMD Output",
        "icon": "$(symbol-array)"
      },
      {
        "command": "iris.explainError",
        "title": "IRIS: Explain Error Code",
        "icon": "$(question)"
      },
      {
        "command": "iris.checkFormat",
        "title": "IRIS: Check Formatting",
        "icon": "$(check)"
      },
      {
        "command": "iris.runTests",
        "title": "IRIS: Run Tests in File",
        "icon": "$(beaker)"
      },
      {
        "command": "iris.runBench",
        "title": "IRIS: Run Benchmarks",
        "icon": "$(dashboard)"
      },
      {
        "command": "iris.generateDocs",
        "title": "IRIS: Generate Documentation",
        "icon": "$(book)"
      },
      {
        "command": "iris.pkg",
        "title": "IRIS: Package Manager...",
        "icon": "$(package)"
      },
      {
        "command": "iris.diagnostics",
        "title": "IRIS: Diagnose Toolchain",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "iris.runFile",
          "when": "resourceExtname == .iris",
          "group": "navigation"
        },
        {
          "command": "iris.debugFile",
          "when": "resourceExtname == .iris",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "iris.runFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.buildFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.debugFile",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.openRepl"
        },
        {
          "command": "iris.restartLsp"
        },
        {
          "command": "iris.stopLsp"
        },
        {
          "command": "iris.showIR",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showLLVM",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showVersion"
        },
        {
          "command": "iris.showEmit",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showGraph",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showCuda",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.showSimd",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.explainError"
        },
        {
          "command": "iris.checkFormat",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.runTests",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.runBench",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.generateDocs",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "iris.pkg"
        },
        {
          "command": "iris.diagnostics"
        }
      ]
    },
    "keybindings": [
      {
        "command": "iris.runFile",
        "key": "ctrl+f5",
        "when": "resourceExtname == .iris && !inDebugMode"
      }
    ],
    "configuration": {
      "title": "IRIS",
      "properties": {
        "iris.executablePath": {
          "type": "string",
          "default": "iris",
          "description": "Path to the iris executable. Defaults to 'iris' (must be in PATH).",
          "scope": "machine-overridable"
        },
        "iris.maxNumberOfProblems": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of problems (errors/warnings) shown in the Problems panel."
        },
        "iris.formatOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically format .iris files on save."
        },
        "iris.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication between VS Code and the IRIS language server.",
          "enumDescriptions": [
            "No tracing",
            "Log messages only",
            "Log messages and their contents"
          ]
        },
        "iris.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inlay hints (type annotations on bindings)."
        },
        "iris.inlayHints.typeHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred binding hints on val/var bindings."
        },
        "iris.debug.stopOnEntry": {
          "type": "boolean",
          "default": false,
          "description": "Stop at the first executable trace point when debugging an IRIS file."
        },
        "iris.showTimingOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Show elapsed compile+run time in the output channel."
        },
        "iris.sandbox": {
          "type": "boolean",
          "default": false,
          "description": "Pass --sandbox when running or building, denying filesystem, network, FFI and process access."
        },
        "iris.noCache": {
          "type": "boolean",
          "default": false,
          "description": "Pass --no-cache to disable incremental compilation."
        },
        "iris.target": {
          "type": "string",
          "default": "",
          "description": "Target preset or triple used by IRIS: Build Binary (e.g. linux-arm64). Empty means the host target.",
          "scope": "machine-overridable"
        }
      }
    },
    "snippets": [
      {
        "language": "iris",
        "path": "./snippets/iris.json"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
