# The runtime C sources are hashed to decide whether the shipped prebuilt
# objects still match them (see build.rs::runtime_sources_hash). Keeping them
# LF in the working tree makes that hash reproducible across machines; the hash
# also normalises line endings, so this is belt and braces. See known-issues #50.
src/runtime/*.c  text eol=lf
src/runtime/*.h  text eol=lf

# Prebuilt object files must never be line-ending converted.
src/runtime/prebuilt/**  binary
