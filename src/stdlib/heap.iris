// src/stdlib/heap.iris -- IRIS standard min-heap (generic, sorted-list backend)
//
// Elements are stored in sorted ascending order in a list.
// O(n) insertion, O(1) peek, O(n) pop.

/// A min-heap containing elements of type T.
record MinHeap[T] { data: list<T> }

/// Create a new, empty min-heap.
///
/// Takes no seed. The previous signature was `heap_new[T](v: T)`, which seeded
/// the heap purely so `T` could be inferred from an argument — leaving an empty
/// heap unconstructible.
pub def heap_new[T]() -> MinHeap<T> {
    var d: list<T> = list()
    MinHeap { data: d }
}

/// Create a heap seeded with one value, for callers that want the old shape.
pub def heap_of[T](v: T) -> MinHeap<T> {
    var d: list<T> = list()
    push(d, v);
    MinHeap { data: d }
}

/// Return the number of elements in the heap.
pub def heap_len[T](h: MinHeap<T>) -> i64 {
    list_len(h.data)
}

/// Return true if the heap has no elements.
pub def heap_is_empty[T](h: MinHeap<T>) -> bool {
    list_len(h.data) == 0
}

/// Return the minimum element without removing it.
pub def heap_peek[T](h: MinHeap<T>) -> T {
    list_get(h.data, 0)
}

/// Remove and return the minimum element plus the updated heap.
pub def heap_pop[T](h: MinHeap<T>) -> (T, MinHeap<T>) {
    val v = list_get(h.data, 0)
    var new_data: list<T> = list()
    var i = 1
    val n = list_len(h.data)
    while i < n {
        push(new_data, list_get(h.data, i));
        i = i + 1
    }
    (v, MinHeap { data: new_data })
}

/// The minimum element, discarding the updated heap.
///
/// `heap_pop` returns a `(value, heap)` tuple, which is awkward when only one
/// half is wanted — and destructuring it at the call site is what the tests were
/// written against. These two accessors were referenced by the test suite but had
/// never been defined.
pub def heap_pop_val[T](h: MinHeap<T>) -> T {
    list_get(h.data, 0)
}

/// The heap remaining after removing the minimum element.
pub def heap_pop_heap[T](h: MinHeap<T>) -> MinHeap<T> {
    var new_data: list<T> = list()
    var i = 1
    val n = list_len(h.data)
    while i < n {
        push(new_data, list_get(h.data, i));
        i = i + 1
    }
    MinHeap { data: new_data }
}

/// Insert v into the heap maintaining sorted order.
pub def heap_push[T](h: MinHeap<T>, v: T) -> MinHeap<T> {
    var new_data: list<T> = list()
    var inserted = 0
    var i = 0
    val n = list_len(h.data)
    while i < n {
        val cur = list_get(h.data, i)
        val should_insert = if v < cur { if inserted == 0 { 1 } else { 0 } } else { 0 }
        inserted = if should_insert == 1 { 1 } else { inserted }
        val _ = if should_insert == 1 { push(new_data, v); 0 } else { 0 }
        push(new_data, cur);
        i = i + 1
    }
    val _ = if inserted == 0 { push(new_data, v); 0 } else { 0 }
    MinHeap { data: new_data }
}

/// Build a heap from a list.
pub def heap_from_list[T](lst: list<T>) -> MinHeap<T> {
    var h: MinHeap<T> = heap_of(list_get(lst, 0))
    var i = 1
    val n = list_len(lst)
    while i < n {
        h = heap_push(h, list_get(lst, i));
        i = i + 1
    }
    h
}

/// Return the elements as a sorted list.
pub def heap_to_list[T](h: MinHeap<T>) -> list<T> {
    var result: list<T> = list()
    var i = 0
    val n = list_len(h.data)
    while i < n {
        push(result, list_get(h.data, i));
        i = i + 1
    }
    result
}

/// Merge two heaps into one.
pub def heap_merge[T](a: MinHeap<T>, b: MinHeap<T>) -> MinHeap<T> {
    var result: MinHeap<T> = a
    var i = 0
    val n = list_len(b.data)
    while i < n {
        result = heap_push(result, list_get(b.data, i));
        i = i + 1
    }
    result
}
