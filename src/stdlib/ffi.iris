// src/stdlib/ffi.iris -- IRIS standard FFI (Foreign Function Interface) library
//
// Supports C, Python, and Rust interop for dynamic library calls and scripting.

// ── C / Native FFI ──

/// Open a dynamic library (.dll / .so / .dylib).
/// Returns a handle (i64), or -1 on error.
// Open a shared library. Returns a handle, or a non-positive sentinel on
// failure.
//
// The two backends disagree on which sentinel: the interpreter returns -1 and
// native returns 0. Every guard in this module therefore rejects both. Testing
// only `== -1` meant a failed `lib_open` passed the guard natively, and each
// subsequent call failed separately against a null handle -- the failure
// surfaced far from its cause. See known-issues #41.
pub def lib_open(path: str) -> i64 effect ffi {
    ffi_open(path)
}

/// Call a zero-argument function in a loaded library.
/// Returns i64 result.
pub def lib_call(handle: i64, func_name: str) -> i64 effect ffi {
    ffi_call(handle, func_name)
}

/// Call a function with an i64 argument, returning i64.
pub def call_i64(handle: i64, func_name: str, a1: i64) -> i64 effect ffi {
    ffi_call_i64(handle, func_name, a1)
}

/// Call a function returning f64.
pub def call_f64(handle: i64, func_name: str, a1: i64) -> f64 effect ffi {
    ffi_call_f64(handle, func_name, a1)
}

/// Call a function returning a string.
pub def call_str(handle: i64, func_name: str) -> str effect ffi {
    ffi_call_str(handle, func_name)
}

/// Close a dynamic library handle.
pub def lib_close(handle: i64) -> bool effect ffi {
    ffi_close(handle)
}

// ── Out-parameter cells ──────────────────────────────────────────────────────
//
// A great many C functions return their result through a pointer argument:
//
//     int64_t iris_rcl_take_twist(int64_t sub, double* out);   // writes 6 doubles
//     int64_t iris_rcl_take_string(int64_t sub, char* buf, int32_t max);
//
// None of those were callable from IRIS. The dispatcher already passes an array
// of i64 slots and a pointer fits in one, so the gap was never the calling
// convention -- it was that IRIS had no way to own memory and name its address.
//
// `out_new` returns that address as an ordinary i64, so it is passed with the
// existing `call_i64_2` / `call_i64_3`. Ownership is the caller's: always pair a
// successful `out_new` with `out_free`, including on the error path.

/// Allocate a zeroed cell of `nbytes` and return its address.
/// Returns 0 on failure. The caller must `out_free` it.
pub def out_new(nbytes: i64) -> i64 effect ffi, alloc {
    ffi_out_new(nbytes)
}

/// Allocate a cell sized for `n` f64 values.
pub def out_f64_cell(n: i64) -> i64 effect ffi, alloc {
    ffi_out_new(n * 8)
}

/// Allocate a cell sized for `n` i64 values.
pub def out_i64_cell(n: i64) -> i64 effect ffi, alloc {
    ffi_out_new(n * 8)
}

/// Read the f64 at `index` from a cell.
pub def out_f64(cell: i64, index: i64) -> f64 effect ffi {
    ffi_out_get_f64(cell, index)
}

/// Read the i64 at `index` from a cell.
pub def out_i64(cell: i64, index: i64) -> i64 effect ffi {
    ffi_out_get_i64(cell, index)
}

/// Read the cell as a NUL-terminated string.
pub def out_str(cell: i64) -> str effect ffi {
    ffi_out_get_str(cell)
}

/// Seed an f64 before the call, for in-out parameters.
pub def out_set_f64(cell: i64, index: i64, v: f64) -> i64 effect ffi {
    ffi_out_set_f64(cell, index, v)
}

/// Seed an i64 before the call, for in-out parameters.
pub def out_set_i64(cell: i64, index: i64, v: i64) -> i64 effect ffi {
    ffi_out_set_i64(cell, index, v)
}

/// Release a cell. Safe on 0 and safe to call twice.
pub def out_free(cell: i64) -> i64 effect ffi {
    ffi_out_free(cell)
}

// ── Python FFI ──

/// Evaluate a Python expression and return the result as a string.
pub def py_eval(code: str) -> str effect ffi {
    python_eval(code)
}

/// Execute a Python script file or inline code.
/// Returns exit code (0 on success).
pub def py_exec(code_or_path: str) -> i64 effect ffi {
    python_exec(code_or_path)
}

/// Call a Python function: `py_call("math", "sqrt", "16")` => "4.0".
pub def py_call(module: str, func: str, args: str) -> str effect ffi {
    python_call(module, func, args)
}

/// Get the Python version string.
pub def py_version() -> str effect ffi {
    python_version()
}

// ── Rust FFI (cdylib) ──

/// Open a Rust cdylib (.dll / .so / .dylib).
/// Uses same mechanism as C FFI.
pub def rust_open(path: str) -> i64 effect ffi {
    rust_lib_open(path)
}

/// Call a Rust extern "C" function returning i64.
pub def rust_i64(handle: i64, func_name: str, a1: i64) -> i64 effect ffi {
    rust_call_i64(handle, func_name, a1)
}

/// Call a Rust extern "C" function returning f64.
pub def rust_f64(handle: i64, func_name: str, a1: i64) -> f64 effect ffi {
    rust_call_f64(handle, func_name, a1)
}

// ── Two-argument convenience wrappers ──
// These cover the most common BLAS / LAPACK calling patterns.

/// Call a C function with two i64 arguments, returning i64.
pub def call_i64_2(handle: i64, func_name: str, a1: i64, a2: i64) -> i64 effect ffi {
    ffi_call_i64(handle, func_name, a1, a2)
}

/// Call a C function with three i64 arguments, returning i64.
pub def call_i64_3(handle: i64, func_name: str, a1: i64, a2: i64, a3: i64) -> i64 effect ffi {
    ffi_call_i64(handle, func_name, a1, a2, a3)
}

/// Call a C function with two i64 arguments, returning f64.
pub def call_f64_2(handle: i64, func_name: str, a1: i64, a2: i64) -> f64 effect ffi {
    ffi_call_f64(handle, func_name, a1, a2)
}

/// Execute a shell command, returning its stdout as a string.
pub def shell(cmd: str) -> str effect sys {
    exec_cmd(cmd)
}

/// Convenience: call a Python module function with a single string argument.
pub def py_call1(module: str, func: str, arg: str) -> str effect ffi {
    python_call(module, func, arg)
}