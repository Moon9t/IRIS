// src/stdlib/async.iris -- IRIS standard async/concurrency library
//
// Provides non-blocking channel operations, thread utilities, and timing functions.

/// Try to receive from a channel without blocking.
/// Returns `some(value)` if available, `none` otherwise.
pub def try_recv(ch: chan<i64>) -> option<i64> {
    chan_try_recv(ch)
}

/// Create a new bounded channel with the specified capacity.
pub def channel_bounded(capacity: i64) -> chan<i64> {
    channel(capacity)
}

/// Create a new unbounded channel.
pub def channel_unbounded() -> chan<i64> {
    channel(-1)
}

/// Get the number of pending messages in a channel.
pub def channel_len(ch: chan<i64>) -> i64 {
    chan_len(ch)
}

/// Sleep for a given number of milliseconds.
/// Returns `true` when the timeout completes.
pub def sleep(ms: i64) -> bool effect time {
    timeout(ms)
}

/// Get the number of available hardware threads.
pub def num_threads() -> i64 {
    thread_count()
}

/// Get current Unix timestamp in seconds.
pub def now() -> i64 effect time {
    datetime_timestamp() to i64
}

/// Sleep for `ms` milliseconds.
/// Returns `true` after the delay completes.
pub def delay(ms: i64) -> bool effect time {
    timeout(ms)
}

/// Select the first ready channel from a list (returns index 0..n-1, or -1 if none ready).
pub def select_first(channels: list<chan<i64>>) -> i64 {
    val n = list_len(channels)
    var i = 0
    while i < n {
        val ch = list_get(channels, i)
        if chan_len(ch) > 0 { return i }
        i = i + 1
    }
    -1
}

/// Receive from channel with a timeout in milliseconds.
/// Returns `some(val)` if received before timeout, `none` otherwise.
pub def recv_timeout_ms(ch: chan<i64>, timeout_ms: i64) -> option<i64> {
    recv_timeout(ch, timeout_ms)
}

/// Create a new structured TaskGroup.
pub def new_task_group() -> task_group {
    task_group()
}

/// Force a cycle collection sweep on the GC side-table.
pub def gc_collect_sweep() -> bool {
    gc_collect()
}

/// Retrieve current GC allocation and collection statistics.
pub def gc_get_stats() -> map<str, i64> {
    gc_stats()
}