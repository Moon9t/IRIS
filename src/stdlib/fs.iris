// src/stdlib/fs.iris -- IRIS standard filesystem library

pub record File {
    handle: i64,
}

pub def file_open_stream(path: str, mode: str) -> result<File, str> effect fs, io {
    val h = file_open(path, mode);
    if h == 0 {
        err(concat("Failed to open file: ", path))
    } else {
        ok(File { handle: h })
    }
}

pub def file_close_stream(f: File) -> result<bool, str> effect fs, io {
    val b = file_close(f.handle);
    if b {
        ok(true)
    } else {
        err("Failed to close file")
    }
}

pub def file_read_stream(f: File, bytes: i64) -> result<str, str> effect fs, io {
    val s = file_read(f.handle, bytes);
    ok(s)
}

pub def file_write_stream(f: File, data: str) -> result<bool, str> effect fs, io {
    val b = file_write(f.handle, data);
    if b {
        ok(true)
    } else {
        err("Failed to write to file")
    }
}

/// Read entire file contents
pub def read_text(path: str) -> result<str, str> effect fs, io {
    file_read_all(path)
}

/// Write text to a file
pub def write_text(path: str, content: str) -> result<bool, str> effect fs, io {
    val r = file_write_all(path, content);
    when r {
        ok(bytes) => ok(true),
        err(e) => err(e)
    }
}

/// Append text to a file
pub def append_text(path: str, content: str) -> result<bool, str> effect fs, io {
    val h = file_open_stream(path, "a");
    when h {
        ok(f) => {
            val w = file_write_stream(f, content);
            file_close_stream(f);
            w
        },
        err(e) => err(e)
    }
}

/// Returns true if the path exists.
pub def path_exists(path: str) -> bool effect fs, io {
    file_exists(path)
}

/// Read a file and return its lines as a list<str>.
pub def read_lines(path: str) -> result<list<str>, str> effect fs, io {
    if !path_exists(path) {
        return err("File not found");
    }
    ok(file_lines(path))
}

/// Copy src to dst
pub def copy_file(src: str, dst: str) -> result<bool, str> effect fs, io {
    val content = read_text(src);
    when content {
        ok(s) => write_text(dst, s),
        err(e) => err(e)
    }
}
