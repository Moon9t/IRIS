bring std.ml

// ---------------------------------------------------------------------------
// Experience Replay Buffer
// ---------------------------------------------------------------------------

/// A single experience tuple: (state, action, reward, next_state, done)
/// Stored as flat lists for memory efficiency.

pub record Experience {
    state: list<f64>,
    action: i64,
    reward: f64,
    next_state: list<f64>,
    done: bool
}

pub record ReplayBuffer {
    states: list<list<f64>>,
    actions: list<i64>,
    rewards: list<f64>,
    next_states: list<list<f64>>,
    dones: list<bool>,
    capacity: i64,
    size: i64,
    next_idx: i64
}

/// Create a new replay buffer with given capacity.
pub def replay_buffer_new(capacity: i64) -> ReplayBuffer {
    ReplayBuffer {
        states: list(),
        actions: list(),
        rewards: list(),
        next_states: list(),
        dones: list(),
        capacity: capacity,
        size: 0,
        next_idx: 0
    }
}

/// Add an experience to the buffer (FIFO eviction when full).
pub def replay_buffer_push(buf: ReplayBuffer, exp: Experience) -> ReplayBuffer {
    if buf.capacity <= 0 { return buf }

    // Mutate lists in-place (reference types)
    if buf.size < buf.capacity {
        list_push(buf.states, exp.state);
        list_push(buf.actions, exp.action);
        list_push(buf.rewards, exp.reward);
        list_push(buf.next_states, exp.next_state);
        list_push(buf.dones, exp.done)
    } else {
        val idx = buf.next_idx;
        if idx >= 0 && idx < list_len(buf.states) {
            list_set(buf.states, idx, exp.state);
            list_set(buf.actions, idx, exp.action);
            list_set(buf.rewards, idx, exp.reward);
            list_set(buf.next_states, idx, exp.next_state);
            list_set(buf.dones, idx, exp.done)
        }
    };

    // Update size and next_idx (value semantics — build new record)
    val new_size = if buf.size < buf.capacity { buf.size + 1 } else { buf.size };
    val new_next_idx = (buf.next_idx + 1) % buf.capacity;

    ReplayBuffer {
        states: buf.states,
        actions: buf.actions,
        rewards: buf.rewards,
        next_states: buf.next_states,
        dones: buf.dones,
        capacity: buf.capacity,
        size: new_size,
        next_idx: new_next_idx
    }
}

/// Sample a random batch of indices from the buffer.
pub def replay_buffer_sample_indices(buf: ReplayBuffer, batch_size: i64) -> list<i64> {
    val indices : list<i64> = list()
    val max_idx = if buf.size < buf.capacity { buf.size } else { buf.capacity }
    if max_idx <= 0 { return indices }

    for i in 0 .. batch_size {
        list_push(indices, random_range(0, max_idx - 1))
    }
    indices
}

/// Sample a random batch of full Experience records from the buffer.
pub def replay_buffer_sample(buf: ReplayBuffer, batch_size: i64) -> list<Experience> {
    val batch : list<Experience> = list()
    val indices = replay_buffer_sample_indices(buf, batch_size)
    for i in 0 .. list_len(indices) {
        val idx = list_get(indices, i)
        if idx >= 0 && idx < list_len(buf.states) {
            val exp = Experience {
                state: list_get(buf.states, idx),
                action: list_get(buf.actions, idx),
                reward: list_get(buf.rewards, idx),
                next_state: list_get(buf.next_states, idx),
                done: list_get(buf.dones, idx)
            }
            list_push(batch, exp);
        }
    }
    batch
}

// ---------------------------------------------------------------------------
// Q-Learning (Tabular)
// ---------------------------------------------------------------------------

/// Initialize a Q-table as a flat list of zeros.
/// Indexed as: Q[state * n_actions + action]
pub def q_table_new(n_states: i64, n_actions: i64) -> list<f64> {
    val q : list<f64> = list()
    val total = if n_states * n_actions <= 0 { 0 } else { n_states * n_actions }
    for i in 0 .. total {
        list_push(q, 0.0)
    }
    q
}

/// Get Q-value: Q(state, action)
pub def q_get(q: list<f64>, state: i64, action: i64, n_actions: i64) -> f64 {
    val idx = state * n_actions + action
    if idx < 0 || idx >= list_len(q) { return 0.0 }
    list_get(q, idx)
}

/// Set Q-value: Q(state, action) = value
pub def q_set(q: list<f64>, state: i64, action: i64, n_actions: i64, value: f64) -> i64 {
    val idx = state * n_actions + action
    if idx >= 0 && idx < list_len(q) {
        list_set(q, idx, value);
    }
    0
}

/// Q-learning update:
///   Q(s,a) += alpha * (reward + gamma * max_a' Q(s', a') - Q(s,a))
pub def q_learning_update(q: list<f64>, state: i64, action: i64,
                           reward: f64, next_state: i64, n_actions: i64,
                           alpha: f64, gamma: f64) -> f64 {
    val idx = state * n_actions + action
    if idx < 0 || idx >= list_len(q) { return 0.0 }
    val current = q_get(q, state, action, n_actions)

    // Find max Q(s', a')
    var max_next = 0.0
    val next_idx_base = next_state * n_actions
    if next_idx_base >= 0 && next_idx_base < list_len(q) {
        max_next = q_get(q, next_state, 0, n_actions)
        for a in 1 .. n_actions {
            val v = q_get(q, next_state, a, n_actions)
            if v > max_next { max_next = v }
        }
    }

    val td_target = reward + gamma * max_next
    val new_value = current + alpha * (td_target - current)
    q_set(q, state, action, n_actions, new_value);
    new_value
}

/// SARSA update:
///   Q(s,a) += alpha * (reward + gamma * Q(s', a') - Q(s,a))
pub def sarsa_update(q: list<f64>, state: i64, action: i64,
                      reward: f64, next_state: i64, next_action: i64,
                      n_actions: i64, alpha: f64, gamma: f64) -> f64 {
    val idx = state * n_actions + action
    if idx < 0 || idx >= list_len(q) { return 0.0 }
    val current = q_get(q, state, action, n_actions)
    val next_q = q_get(q, next_state, next_action, n_actions)
    val new_value = current + alpha * (reward + gamma * next_q - current)
    q_set(q, state, action, n_actions, new_value);
    new_value
}

/// Choose the best action for a state from the Q-table (greedy).
pub def q_best_action(q: list<f64>, state: i64, n_actions: i64) -> i64 {
    if n_actions <= 0 { return -1 }
    var best = 0
    var best_val = q_get(q, state, 0, n_actions)
    for a in 1 .. n_actions {
        val v = q_get(q, state, a, n_actions)
        if v > best_val {
            best_val = v
            best = a
        }
    }
    best
}

// ---------------------------------------------------------------------------
// Policy Gradient Helpers
// ---------------------------------------------------------------------------

/// Compute policy gradient loss for a batch of (log_prob, advantage) pairs.
/// Returns: -mean(log_prob * advantage)
pub def policy_gradient_loss(log_probs: list<f64>, advantages: list<f64>) -> f64 {
    val n = list_len(log_probs)
    if n == 0 { return 0.0 }
    var total = 0.0
    for i in 0 .. n {
        total = total - list_get(log_probs, i) * list_get(advantages, i)
    }
    total / to_f64(n)
}

/// Compute log-probability under a simple softmax policy.
/// Given logits for all actions, returns log_prob of the chosen action.
pub def log_prob_softmax(logits: list<f64>, action: i64) -> f64 {
    val n = list_len(logits)
    if n == 0 || action < 0 || action >= n { return -100.0 }

    // log_softmax = logit[action] - log(sum(exp(logits)))
    var mx = list_get(logits, 0)
    for i in 1 .. n {
        val v = list_get(logits, i)
        if v > mx { mx = v }
    }
    var sum_exp = 0.0
    for i in 0 .. n {
        sum_exp = sum_exp + exp(list_get(logits, i) - mx)
    }
    list_get(logits, action) - mx - log(sum_exp)
}

/// Compute the PPO clipped policy loss over a batch of transitions.
/// L_clip = -mean(min(r * A, clip(r, 1-eps, 1+eps) * A))
pub def ppo_clip_loss(log_probs: list<f64>, old_log_probs: list<f64>,
                      advantages: list<f64>, epsilon: f64) -> f64 {
    val n = list_len(log_probs)
    if n == 0 { return 0.0 }

    val eps = if epsilon < 0.0 { 0.0 } else { epsilon }
    val low = 1.0 - eps
    val high = 1.0 + eps

    var total_loss = 0.0
    for i in 0 .. n {
        val lp = list_get(log_probs, i)
        val old_lp = list_get(old_log_probs, i)
        val adv = list_get(advantages, i)

        val r = exp(lp - old_lp)
        val surr1 = r * adv

        val clipped_r = if r < low { low } else { if r > high { high } else { r } }
        val surr2 = clipped_r * adv

        val min_surr = if surr1 < surr2 { surr1 } else { surr2 }
        total_loss = total_loss - min_surr
    }
    total_loss / to_f64(n)
}

/// Compute the entropy of a softmax distribution from its logits.
/// Entropy = -sum(prob * log(prob))
pub def softmax_entropy(logits: list<f64>) -> f64 {
    val n = list_len(logits)
    if n <= 0 { return 0.0 }

    // Find max for numerical stability
    var mx = list_get(logits, 0)
    for i in 1 .. n {
        val v = list_get(logits, i)
        if v > mx { mx = v }
    }

    // Compute probabilities and log-probabilities
    val probs : list<f64> = list()
    var sum_exp = 0.0
    for i in 0 .. n {
        val e = exp(list_get(logits, i) - mx)
        list_push(probs, e);
        sum_exp = sum_exp + e
    }

    if sum_exp <= 1.0e-15 {
        return 0.0
    }

    var entropy = 0.0
    for i in 0 .. n {
        val p = list_get(probs, i) / sum_exp
        if p > 1.0e-15 {
            entropy = entropy - p * log(p)
        }
    }
    entropy
}

// ---------------------------------------------------------------------------
// Environment Interface
// ---------------------------------------------------------------------------

/// Simple grid-world environment for testing RL agents.
/// State is a single integer (position), action is 0=left, 1=right.
/// Returns (new_state, reward, done).
pub def grid_step(state: i64, action: i64, grid_size: i64) -> (i64, f64, bool) {
    val new_state = if action == 0 {
        if state > 0 { state - 1 } else { 0 }
    } else {
        if state < grid_size - 1 { state + 1 } else { grid_size - 1 }
    }
    val at_goal = new_state == grid_size - 1
    val reward = if at_goal { 1.0 } else { -0.01 }
    (new_state, reward, at_goal)
}

/// Multi-armed bandit environment.
/// Returns a random reward drawn from each arm's distribution.
pub def bandit_pull(arm: i64, n_arms: i64) -> f64 {
    // Each arm has a different mean reward
    val mean = to_f64(arm + 1) / to_f64(n_arms + 1)
    mean + (random() - 0.5) * 0.2
}

// ---------------------------------------------------------------------------
// Contextual Bandit
// ---------------------------------------------------------------------------

/// Create a new flat weight list for a contextual bandit with n_actions and n_features.
pub def contextual_bandit_new(n_actions: i64, n_features: i64) -> list<f64> {
    val weights: list<f64> = list()
    val total = n_actions * n_features
    for i in 0 .. total {
        list_push(weights, 0.0)
    }
    weights
}

/// Compute action values Q(context, action) for all actions.
pub def contextual_bandit_values(weights: list<f64>, context: list<f64>, n_actions: i64, n_features: i64) -> list<f64> {
    val values: list<f64> = list()
    for a in 0 .. n_actions {
        var val_a = 0.0
        val offset = a * n_features
        for f in 0 .. n_features {
            val_a = val_a + list_get(weights, offset + f) * list_get(context, f)
        }
        list_push(values, val_a)
    }
    values
}

/// Select action using epsilon-greedy exploration.
pub def contextual_bandit_select(weights: list<f64>, context: list<f64>, n_actions: i64, n_features: i64, epsilon: f64) -> i64 {
    val values = contextual_bandit_values(weights, context, n_actions, n_features)
    if random() < epsilon {
        random_range(0, n_actions - 1)
    } else {
        var best_a = 0
        var best_v = list_get(values, 0)
        for a in 1 .. n_actions {
            val v = list_get(values, a)
            if v > best_v {
                best_v = v
                best_a = a
            }
        }
        best_a
    }
}

/// Update weights using SGD error correction.
pub def contextual_bandit_update(weights: list<f64>, context: list<f64>, action: i64, reward: f64, n_features: i64, lr: f64) -> list<f64> {
    val values: list<f64> = list()
    // Recompute only selected action's value
    var val_a = 0.0
    val offset = action * n_features
    for f in 0 .. n_features {
        val_a = val_a + list_get(weights, offset + f) * list_get(context, f)
    }
    val td_error = reward - val_a
    for f in 0 .. n_features {
        val idx = offset + f
        val old_w = list_get(weights, idx)
        list_set(weights, idx, old_w + lr * td_error * list_get(context, f))
    }
    weights
}

