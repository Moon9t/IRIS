    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <keyword attribute="Control Flow" String="controlflow" context="#stay"/>
        <keyword attribute="Keyword" String="keywords" context="#stay"/>
        <keyword attribute="Data Type" String="types" context="#stay"/>
        <keyword attribute="Constant" String="constants" context="#stay"/>
        <keyword attribute="Builtin" String="builtins" context="#stay"/>
        
        <!-- Numbers -->
        <RegExpr attribute="Float" String="\b[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?\b" context="#stay"/>
        <RegExpr attribute="Hex" String="\b0x[0-9a-fA-F]+\b" context="#stay"/>
        <RegExpr attribute="Integer" String="\b[0-9]+\b" context="#stay"/>

        <!-- Strings -->
        <DetectChar attribute="String" char="&quot;" context="String"/>
        <Detect2Chars attribute="String" char="f" char1="&quot;" context="FString"/>

        <!-- Comments -->
        <Detect2Chars attribute="Comment" char="/" char1="/" context="CommentLine"/>
        <Detect2Chars attribute="Comment" char="/" char1="*" context="CommentBlock"/>

        <!-- Operators -->
        <AnyChar attribute="Operator" String="+-*/%=&lt;&gt;!&amp;|?." context="#stay"/>
        <Detect2Chars attribute="Operator" char="-" char1="&gt;" context="#stay"/>
      </context>

      <context name="CommentLine" attribute="Comment" lineEndContext="#pop">
      </context>

      <context name="CommentBlock" attribute="Comment" lineEndContext="#stay">
        <Detect2Chars attribute="Comment" char="*" char1="/" context="#pop"/>
      </context>

      <context name="String" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" char="&quot;" context="#pop"/>
        <RegExpr attribute="Escape" String="\\\\(n|t|r|\\\\|&quot;)" context="#stay"/>
      </context>

      <context name="FString" attribute="String" lineEndContext="#stay">
        <DetectChar attribute="String" char="&quot;" context="#pop"/>
        <RegExpr attribute="Escape" String="\\\\(n|t|r|\\\\|&quot;)" context="#stay"/>
        <DetectChar attribute="Brace" char="{" context="Embedded"/>
      </context>

      <context name="Embedded" attribute="Normal Text" lineEndContext="#stay">
        <DetectChar attribute="Brace" char="}" context="#pop"/>
        <IncludeRules context="Normal"/>
      </context>
    </contexts>
    <itemDatas>
