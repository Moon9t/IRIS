// Inline AIS framework test — iterate syntax without rebuilds

bring std.math

// ============ RECORD DEFINITIONS ============

pub record SensorReading {
    values: list<f64>,
    timestamp: i64,
    confidence: f64
}

pub record KnowledgeBase {
    observations: list<list<f64>>,
    actions_taken: list<i64>,
    rewards_received: list<f64>,
    world_model_params: list<f64>
}

pub record HomeostaticVariable {
    current_value: f64,
    set_point: f64,
    tolerance: f64,
    correction_gain: f64,
    integral: f64,
    last_error: f64
}

pub record Homeostat {
    variables: list<HomeostaticVariable>,
    health: f64,
    allostatic_load: f64
}

pub record MetaCognition {
    performance_history: list<f64>,
    self_efficacy: f64
}

pub record BeliefState {
    probs: list<f64>,
    entropy: f64,
    confidence: f64
}

pub record GenerativeModel {
    state_prior: list<f64>,
    likelihood: list<f64>,
    transitions: list<f64>,
    n_states: i64,
    n_obs: i64,
    n_actions: i64
}

pub record Constraint {
    name: str,
    severity: i64
}

pub record Constitution {
    constraints: list<Constraint>,
    total_violations: i64,
    safety_mode: i64
}

pub record WorldModel {
    weights: list<f64>,
    n_state_dim: i64,
    n_action_dim: i64
}

pub record EWCState {
    importance_weights: list<f64>,
    old_params: list<f64>,
    n_tasks: i64,
    lambda_ewc: f64
}

pub record Genome {
    genes: list<f64>,
    fitness: f64,
    age: i64
}

pub record Population {
    genomes: list<Genome>,
    pop_size: i64,
    mutation_rate: f64,
    generation: i64,
    best_fitness: f64,
    avg_fitness: f64
}

pub record RunningStats {
    count: i64,
    mean: f64,
    m2: f64,
    min: f64,
    max: f64
}

// ============ CORE UTILITY FUNCTIONS ============

pub def kb_new() -> KnowledgeBase {
    KnowledgeBase {
        observations: list(),
        actions_taken: list(),
        rewards_received: list(),
        world_model_params: list()
    }
}

pub def kb_record(kb: KnowledgeBase, obs: list<f64>, action: i64, reward: f64) -> KnowledgeBase {
    list_push(kb.observations, obs);
    list_push(kb.actions_taken, action);
    list_push(kb.rewards_received, reward);
    kb
}

pub def argmax(values: list<f64>) -> i64 {
    val n = list_len(values)
    if n <= 0 { return -1 }
    var best_idx = 0
    var best_val = list_get(values, 0)
    for i in 1 .. n {
        val v = list_get(values, i)
        if v > best_val {
            best_val = v
            best_idx = i
        }
    }
    best_idx
}

pub def epsilon_greedy(values: list<f64>, epsilon: f64) -> i64 {
    val n = list_len(values)
    if n <= 0 { return -1 }
    val eps = if epsilon < 0.0 { 0.0 } else { if epsilon > 1.0 { 1.0 } else { epsilon } }
    if random() < eps {
        random_range(0, n - 1)
    } else {
        argmax(values)
    }
}

pub def normalize_list(values: list<f64>) -> list<f64> {
    val n = list_len(values)
    if n == 0 { return values }
    var sum = 0.0
    for i in 0 .. n { sum = sum + list_get(values, i) }
    val mean = sum / to_f64(n)
    var var_sum = 0.0
    for i in 0 .. n {
        val d = list_get(values, i) - mean
        var_sum = var_sum + d * d
    }
    val std = sqrt(var_sum / to_f64(n) + 1.0e-8)
    val result: list<f64> = list()
    for i in 0 .. n {
        list_push(result, (list_get(values, i) - mean) / std)
    }
    result
}

// ============ HOMEOSTATIC REGULATION ============

pub def homeovar_new(set_point: f64, tolerance: f64, gain: f64) -> HomeostaticVariable {
    HomeostaticVariable {
        current_value: set_point,
        set_point: set_point,
        tolerance: tolerance,
        correction_gain: gain,
        integral: 0.0,
        last_error: 0.0
    }
}

pub def homeostat_new() -> Homeostat {
    Homeostat {
        variables: list(),
        health: 1.0,
        allostatic_load: 0.0
    }
}

pub def homeostat_add_var(h: Homeostat, v: HomeostaticVariable) -> Homeostat {
    list_push(h.variables, v);
    h
}

pub def homeostat_update(h: Homeostat, sensor_values: list<f64>, dt: f64) -> (Homeostat, list<f64>) {
    val n_vars = list_len(h.variables)
    val n_sensors = list_len(sensor_values)
    val corrections: list<f64> = list()
    var total_deviation = 0.0
    var new_vars: list<HomeostaticVariable> = list()
    var new_load = h.allostatic_load

    for i in 0 .. n_vars {
        val v = list_get(h.variables, i)
        val sensor_val = if i < n_sensors { list_get(sensor_values, i) } else { v.current_value }

        val error = v.set_point - sensor_val
        val new_integral = v.integral + error * dt
        val correction = v.correction_gain * error + (v.correction_gain * 0.1) * new_integral

        val v_updated = HomeostaticVariable {
            current_value: sensor_val,
            set_point: v.set_point,
            tolerance: v.tolerance,
            correction_gain: v.correction_gain,
            integral: new_integral,
            last_error: error
        }
        list_push(corrections, correction);
        list_push(new_vars, v_updated);

        val deviation = abs(sensor_val - v.set_point)
        total_deviation = total_deviation + deviation
        new_load = new_load + deviation * deviation * 0.01
    }

    val avg_deviation = total_deviation / to_f64(if n_vars <= 0 { 1 } else { n_vars })
    val new_health = 1.0 / (1.0 + avg_deviation)
    val bounded_health = if new_health < 0.0 { 0.0 } else { if new_health > 1.0 { 1.0 } else { new_health } }

    val updated = Homeostat {
        variables: new_vars,
        health: bounded_health,
        allostatic_load: new_load
    }
    (updated, corrections)
}

// ============ ACTIVE INFERENCE ============

pub def genmodel_new(n_states: i64, n_obs: i64, n_actions: i64) -> GenerativeModel {
    val uniform_state = 0.0 - log(to_f64(if n_states <= 0 { 1 } else { n_states }))
    val sp: list<f64> = list()
    for i in 0 .. n_states { list_push(sp, uniform_state) }

    val uniform_obs = 0.0 - log(to_f64(if n_obs <= 0 { 1 } else { n_obs }))
    val lh: list<f64> = list()
    for i in 0 .. (n_obs * n_states) { list_push(lh, uniform_obs) }

    val uniform_trans = 0.0 - log(to_f64(if n_states <= 0 { 1 } else { n_states }))
    val tr: list<f64> = list()
    for i in 0 .. (n_states * n_actions * n_states) { list_push(tr, uniform_trans) }

    GenerativeModel {
        state_prior: sp,
        likelihood: lh,
        transitions: tr,
        n_states: n_states,
        n_obs: n_obs,
        n_actions: n_actions
    }
}

pub def belief_update(beliefs: BeliefState,     gm: GenerativeModel, obs_idx: i64, lr: f64) -> BeliefState {
    val n_states = gm.n_states
    val new_probs: list<f64> = list()
    var total_p = 0.0

    for s in 0 .. n_states {
        val qs = list_get(beliefs.probs, s)
        val log_lik = list_get(gm.likelihood, obs_idx * n_states + s)
        val log_prior = list_get(gm.state_prior, s)

        val grad = if qs > 1.0e-15 { log(qs) + 1.0 - log_prior - log_lik } else { 0.0 - log_prior - log_lik }
        val new_q = qs - lr * grad
        val bounded_q = if new_q < 1.0e-15 { 1.0e-15 } else { new_q }
        list_push(new_probs, bounded_q);
        total_p = total_p + bounded_q
    }

    for i in 0 .. n_states {
        list_set(new_probs, i, list_get(new_probs, i) / total_p);
    }

    var ent = 0.0
    var max_p = 0.0
    for i in 0 .. n_states {
        val p = list_get(new_probs, i)
        if p > 1.0e-15 { ent = ent - p * log(p) }
        if p > max_p { max_p = p }
    }

    BeliefState { probs: new_probs, entropy: ent, confidence: max_p }
}

pub def active_inference_step(gm: GenerativeModel, beliefs: BeliefState, obs_idx: i64, lr: f64) -> (BeliefState, i64) {
    val new_beliefs = belief_update(beliefs, gm, obs_idx, lr)
    val n_actions = gm.n_actions
    var best_action = 0
    var best_efe = 1.0e30

    for a in 0 .. n_actions {
        var efe = 0.0
        for s in 0 .. gm.n_states {
            val qs = list_get(new_beliefs.probs, s)
            if qs > 1.0e-15 {
                efe = efe + qs * 0.0 - log(qs)
            }
        }
        if efe < best_efe {
            best_efe = efe
            best_action = a
        }
    }
    (new_beliefs, best_action)
}

// ============ NEUROEVOLUTION ============

pub def genome_random(n_genes: i64, scale: f64) -> Genome {
    val genes: list<f64> = list()
    for i in 0 .. n_genes {
        list_push(genes, (random() - 0.5) * 2.0 * scale)
    }
    Genome { genes: genes, fitness: 0.0, age: 0 }
}

pub def population_new(pop_size: i64, n_genes: i64, mut_rate: f64) -> Population {
    val genomes: list<Genome> = list()
    for i in 0 .. pop_size {
        list_push(genomes, genome_random(n_genes, 1.0))
    }
    Population {
        genomes: genomes,
        pop_size: pop_size,
        mutation_rate: mut_rate,
        generation: 0,
        best_fitness: -1.0e30,
        avg_fitness: 0.0
    }
}

pub def genome_mutate(g: Genome, rate: f64, scale: f64) -> Genome {
    val new_genes: list<f64> = list()
    for i in 0 .. list_len(g.genes) {
        val gene = list_get(g.genes, i)
        val mutated = if random() < rate { gene + (random() - 0.5) * 2.0 * scale } else { gene }
        list_push(new_genes, mutated)
    }
    Genome { genes: new_genes, fitness: g.fitness, age: g.age + 1 }
}

pub def genome_crossover(a: Genome, b: Genome) -> Genome {
    val na = list_len(a.genes)
    val nb = list_len(b.genes)
    val n = if na < nb { na } else { nb }
    val new_genes: list<f64> = list()
    for i in 0 .. n {
        list_push(new_genes, if random() < 0.5 { list_get(a.genes, i) } else { list_get(b.genes, i) })
    }
    val longer = if na > nb { a.genes } else { b.genes }
    for i in n .. list_len(longer) {
        list_push(new_genes, list_get(longer, i))
    }
    Genome { genes: new_genes, fitness: 0.0, age: 0 }
}

pub def normal_sample() -> f64 {
    var u1 = random()
    if u1 < 0.000000000001 { u1 = 0.000000000001 }
    val u2 = random()
    sqrt(0.0 - 2.0 * log(u1)) * cos(2.0 * 3.141592653589793 * u2)
}

// ============ CONTINUAL LEARNING (EWC) ============

pub def ewc_new(n_params: i64, lambda_ewc: f64) -> EWCState {
    val importance: list<f64> = list()
    val old_params: list<f64> = list()
    for i in 0 .. n_params {
        list_push(importance, 0.0);
        list_push(old_params, 0.0)
    }
    EWCState { importance_weights: importance, old_params: old_params, n_tasks: 0, lambda_ewc: lambda_ewc }
}

pub def ewc_penalty(ewc: EWCState, current_params: list<f64>) -> f64 {
    var penalty = 0.0
    for i in 0 .. list_len(current_params) {
        val diff = list_get(current_params, i) - list_get(ewc.old_params, i)
        penalty = penalty + list_get(ewc.importance_weights, i) * diff * diff
    }
    ewc.lambda_ewc * 0.5 * penalty
}

// ============ SAFETY CONSTITUTION ============

pub def constitution_new(safety_mode: i64) -> Constitution {
    Constitution { constraints: list(), total_violations: 0, safety_mode: safety_mode }
}

pub def constitution_add(c: Constitution, name: str, severity: i64) -> Constitution {
    val constraint = Constraint { name: name, severity: severity }
    list_push(c.constraints, constraint);
    c
}

// ============ WORLD MODEL ============

pub def world_model_new(n_state_dim: i64, n_action_dim: i64) -> WorldModel {
    val n_in = n_state_dim + n_action_dim
    val n_out = n_state_dim
    val weights: list<f64> = list()
    for i in 0 .. (n_in * n_out) {
        list_push(weights, (random() - 0.5) * 0.1)
    }
    WorldModel { weights: weights, n_state_dim: n_state_dim, n_action_dim: n_action_dim }
}

// ============ RUNNING STATS ============

pub def running_stats_new() -> RunningStats {
    RunningStats { count: 0, mean: 0.0, m2: 0.0, min: 1.0e30, max: -1.0e30 }
}

pub def running_stats_update(rs: RunningStats, x: f64) -> RunningStats {
    val new_count = rs.count + 1
    val delta = x - rs.mean
    val new_mean = rs.mean + delta / to_f64(new_count)
    val delta2 = x - new_mean
    val new_m2 = rs.m2 + delta * delta2
    val new_min = if x < rs.min { x } else { rs.min }
    val new_max = if x > rs.max { x } else { rs.max }
    RunningStats { count: new_count, mean: new_mean, m2: new_m2, min: new_min, max: new_max }
}

pub def running_stats_variance(rs: RunningStats) -> f64 {
    if rs.count < 2 { 0.0 } else { rs.m2 / to_f64(rs.count - 1) }
}

pub def running_stats_std(rs: RunningStats) -> f64 {
    sqrt(running_stats_variance(rs))
}

// ============ MAIN DEMO ============

def main() -> i64 {
    print("=== AIS Framework Test ===");

    // 1. Test homeostatic regulation
    print("--- Homeostatic Regulation ---");
    var h = homeostat_new();
    h = homeostat_add_var(h, homeovar_new(37.0, 1.0, 0.5));
    h = homeostat_add_var(h, homeovar_new(7.4, 0.2, 0.3));

    val sensors: list<f64> = list();
    list_push(sensors, 38.5);
    list_push(sensors, 7.1);

    val result = homeostat_update(h, sensors, 0.1);
    h = result.0;
    val corrections = result.1;
    print(concat("  Health: ", to_str(h.health)));
    print(concat("  Corrections: [", concat(to_str(list_get(corrections, 0)), concat(", ", to_str(list_get(corrections, 1))))));

    // 2. Test active inference
    print("--- Active Inference ---");
    val gm = genmodel_new(3, 4, 2);
    val uniform: list<f64> = list();
    for i in 0 .. 3 { list_push(uniform, 1.0 / 3.0) }
    val beliefs = BeliefState { probs: uniform, entropy: 1.1, confidence: 0.33 };

    val (new_beliefs, action) = active_inference_step(gm, beliefs, 1, 0.1);
    print(concat("  Action chosen: ", to_str(action)));
    print(concat("  Belief confidence: ", to_str(new_beliefs.confidence)));

    // 3. Test neuroevolution
    print("--- Neuroevolution ---");
    val pop = population_new(10, 3, 0.2);
    print(concat("  Population size: ", to_str(pop.pop_size)));
    print(concat("  Generation: ", to_str(pop.generation)));

    // 4. Test EWC
    print("--- Continual Learning (EWC) ---");
    val ewc = ewc_new(5, 1.0);
    val params: list<f64> = list();
    for i in 0 .. 5 { list_push(params, 1.0) }
    val pen = ewc_penalty(ewc, params);
    print(concat("  EWC penalty (zero): ", to_str(pen)));

    // 5. Test running stats
    print("--- Running Stats ---");
    var rs = running_stats_new();
    rs = running_stats_update(rs, 10.0);
    rs = running_stats_update(rs, 20.0);
    rs = running_stats_update(rs, 30.0);
    print(concat("  Mean: ", to_str(rs.mean)));
    print(concat("  Std: ", to_str(running_stats_std(rs))));

    // 6. Test decision strategies
    print("--- Decision Strategies ---");
    val qvals: list<f64> = list();
    list_push(qvals, 1.0);
    list_push(qvals, 3.0);
    list_push(qvals, 2.0);
    print(concat("  Argmax: ", to_str(argmax(qvals))));
    print(concat("  Epsilon-greedy(0.1): ", to_str(epsilon_greedy(qvals, 0.1))));
    val normed = normalize_list(qvals);
    val n0 = to_str(list_get(normed, 0));
    val n1 = to_str(list_get(normed, 1));
    val n2 = to_str(list_get(normed, 2));
    print(concat("  Normalized: [", concat(n0, concat(", ", concat(n1, concat(", ", n2))))));

    print("All AIS framework tests passed!");
    0
}
