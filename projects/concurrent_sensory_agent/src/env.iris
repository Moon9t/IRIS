// env.iris — Environment thread running concurrently and sending perceptions

pub def run_env_thread(tx_chan: chan<list<f64>>, rx_chan: chan<i64>) -> i64 {
    spawn {
        var x = 0;
        var y = 0;
        var step = 0;
        var running = true;
        while running {
            // Receive action from main thread (0: Up, 1: Down, 2: Left, 3: Right, -1: Exit)
            val action = recv(rx_chan);
            if action == -1 {
                running = false;
            } else {
                // Update environment state
                if action == 0 && y > 0 { y = y - 1; }
                if action == 1 && y < 2 { y = y + 1; }
                if action == 2 && x > 0 { x = x - 1; }
                if action == 3 && x < 2 { x = x + 1; }
                
                step = step + 1;
                
                // Build observation list
                val obs = list();
                list_push(obs, to_f64(x));
                list_push(obs, to_f64(y));
                
                // Send back features list
                send(tx_chan, obs);
            }
        }
    };
    0
}
