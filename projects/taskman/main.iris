bring "db.iris"

def print_usage() -> i64 {
    print("Taskman - IRIS Task Manager");
    print("Usage:");
    print("  iris build projects/taskman   (to compile)");
    print("  ./taskman list");
    print("  ./taskman add \"My Task\"");
    print("  ./taskman complete <id>");
    print("  ./taskman delete <id>");
    return 0;
}

def main() -> i64 {
    val a = args();
    val len = list_len(a);
    
    // args() contains the executable name as index 0, index 1 is the first arg.
    if len < 2 {
        print_usage();
        return 1;
    }

    val cmd = list_get(a, 1);
    val database = db.init_db();

    if cmd == "list" {
        db.list_tasks(database);
    } else if cmd == "add" {
        if len < 3 {
            print("Error: Missing task title");
        } else {
            db.add_task(database, list_get(a, 2));
        }
    } else if cmd == "complete" {
        if len < 3 {
            print("Error: Missing task ID");
        } else {
            db.complete_task(database, list_get(a, 2));
        }
    } else if cmd == "delete" {
        if len < 3 {
            print("Error: Missing task ID");
        } else {
            db.delete_task(database, list_get(a, 2));
        }
    } else {
        print(concat("Unknown command: ", cmd));
        print_usage();
    }

    db.close_db(database);
    return 0;
}
