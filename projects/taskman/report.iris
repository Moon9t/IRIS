bring "storage.iris"
bring std.json
bring std.fmt
pub def report_print_list(task_ids : list<i64>) -> i64 {
    val n = len(task_ids);
    if n == 0 {
        print("  (no tasks yet - try: add Buy coffee)")
    }
    else {
        print("");
        print("   ID  Status  Title");
        print("  ---  ------  -----------------------------------------------");
        var i = 0;
        while i<n {
            val id = list_get(task_ids, i);
            val t_opt = storage_load(id);
            if is_some(t_opt) {
                val t = unwrap(t_opt);
                val id_s = pad_int(t.id, 4);
                val icon = task_status_icon(t);
                print(concat("  ", concat(id_s, concat("  ", concat(icon, concat("  ", t.title))))));
                
            }
            else {
                val _missing = 0
            }
            ;
            i = i + 1
        }
        print("")
    }
    ;
    0
}
pub def report_print_stats(task_ids : list<i64>) -> i64 {
    val total = len(task_ids);
    var pending = 0;
    var done = 0;
    var cancelled = 0;
    var i = 0;
    while i<total {
        val id = list_get(task_ids, i);
        val t_opt = storage_load(id);
        if is_some(t_opt) {
            val t = unwrap(t_opt);
            if task_is_done(t) {
                done = done + 1
            }
            else {
                if task_is_cancelled(t) {
                    cancelled = cancelled + 1
                }
                else {
                    pending = pending + 1
                }
                
            }
            
        }
        else {
            val _skip = 0
        }
        ;
        i = i + 1
    }
    print("");
    print(concat("  Total tasks  : ", to_str(total)));
    print(concat("  Pending      : ", to_str(pending)));
    print(concat("  Done         : ", to_str(done)));
    print(concat("  Cancelled    : ", to_str(cancelled)));
    if total>0 {
        val pct = (done * 100) / total;
        print(concat("  Completion   : ", concat(to_str(pct), "%")))
    }
    else {
        print("  Completion   : n/a")
    }
    ;
    print("");
    0
}
pub def report_task_to_json(t : Task) -> str {
    val s0 = concat("{\"id\":", to_str(t.id));
    val s1 = concat(s0, concat(",\"title\":", json_str(t.title)));
    val s2 = concat(s1, concat(",\"status\":", json_str(task_status_name(t))));
    val s3 = concat(s2, concat(",\"created_ms\":", to_str(t.created_ms)));
    val s4 = concat(s3, concat(",\"done_ms\":", to_str(t.done_ms)));
    concat(s4, "}")
}
pub def report_tasks_to_json(task_ids : list<i64>) -> i64 {
    val n = len(task_ids);
    print("[");
    var i = 0;
    while i<n {
        val id = list_get(task_ids, i);
        val t_opt = storage_load(id);
        if is_some(t_opt) {
            val row = concat("  ", report_task_to_json(unwrap(t_opt)));
            if(i + 1)<n {
                print(concat(row, ","))
            }
            else {
                print(row)
            }
            
        }
        else {
            val _skip = 0
        }
        ;
        i = i + 1
    }
    print("]");
    0
}
pub def report_task_to_csv_row(t : Task) -> str {
    concat(to_str(t.id), concat(",", concat("\"", concat(t.title, concat("\"", concat(",", concat(task_status_name(t), concat(",", concat(to_str(t.created_ms), concat(",", to_str(t.done_ms)))))))))))
}
pub def report_tasks_to_csv(task_ids : list<i64>) -> i64 {
    print("id,title,status,created_ms,done_ms");
    val n = len(task_ids);
    var i = 0;
    while i<n {
        val id = list_get(task_ids, i);
        val t_opt = storage_load(id);
        if is_some(t_opt) {
            print(report_task_to_csv_row(unwrap(t_opt)))
        }
        else {
            val _skip = 0
        }
        ;
        i = i + 1
    }
    0
}
