pub def my_monitor(x: i64) -> bool {
    x > 5
}

pub def main() -> i64 {
    val r10 = my_monitor(10);
    print(concat("monitor(10) = ", to_str(r10)));
    val r3 = my_monitor(3);
    print(concat("monitor(3) = ", to_str(r3)));
    val r0 = my_monitor(0);
    print(concat("monitor(0) = ", to_str(r0)));
    0
}
